@model IEnumerable<AshkanCRM.Models.DealEntity>
@{ ViewData["Title"]="Win / Loss Analytics"; }
<div class="page-head"><div><span class="eyebrow">REVENUE INTELLIGENCE</span><h1>Win / Loss Analytics</h1><p>تحلیل نتایج واقعی Pipeline و دلایل بسته‌شدن فرصت‌ها.</p></div><a class="secondary" href="/CRM/ExportSalesCsv?entity=deals">⇩ CSV</a></div>
<div class="stats compact"><article><small>Won</small><strong>@ViewBag.Won</strong></article><article><small>Lost</small><strong>@ViewBag.Lost</strong></article><article><small>Win rate</small><strong>@ViewBag.WinRate%</strong></article><article><small>Won value</small><strong>@(((decimal)ViewBag.WonValue).ToString("N0"))</strong></article></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Deal</th><th>Owner</th><th>Team</th><th>Outcome</th><th>Reason</th><th>Value</th><th>Closed</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Title</b></td><td>@x.Owner</td><td>@x.TeamKey</td><td><span class="badge">@x.Stage</span></td><td>@(string.IsNullOrWhiteSpace(x.OutcomeReason)?"—":x.OutcomeReason)</td><td>@x.Value.ToString("N0")</td><td>@x.ClosedAtUtc?.ToLocalTime().ToString("yyyy/MM/dd")</td></tr>}</tbody></table></div></section>
