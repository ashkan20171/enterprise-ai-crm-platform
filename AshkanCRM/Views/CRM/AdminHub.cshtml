@using System.Globalization
@{ var fa = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa"; }
@{
    ViewData["Title"] = fa ? "داشبورد ادمین" : "Admin dashboard";
}
<div class="page-head"><div><span class="eyebrow">ADMIN CONTROL PLANE</span><h1>@(fa ? "داشبورد ادمین" : "Admin dashboard")</h1><p>@(fa ? "مدیریت متمرکز کاربران، دسترسی‌ها، امنیت، داده و یکپارچه‌سازی‌ها." : "Centralized users, permissions, security, data and integrations.")</p></div><div class="head-actions"><a class="primary" href="/CRM/Users">@(fa ? "＋ تعریف کاربر جدید" : "＋ Add user")</a><a class="ghost" href="/CRM/Permissions">@(fa ? "مدیریت دسترسی‌ها" : "Manage permissions")</a></div></div>
<div class="stat-grid"><div class="stat"><small>@(fa ? "کل کاربران" : "Total users")</small><b>@ViewBag.TotalUsers</b><span>@(fa ? "حساب سازمانی" : "Organization accounts")</span></div><div class="stat"><small>@(fa ? "کاربران فعال" : "Active users")</small><b>@ViewBag.ActiveUsers</b><span>@(fa ? "دسترسی فعال" : "Enabled accounts")</span></div><div class="stat"><small>@(fa ? "حساب قفل‌شده" : "Locked accounts")</small><b>@ViewBag.LockedUsers</b><span>@(fa ? "نیازمند بررسی" : "Needs review")</span></div><div class="stat"><small>@(fa ? "نقش‌های سیستم" : "System roles")</small><b>@ViewBag.RolesCount</b><span>RBAC</span></div></div>
<div class="admin-launch-grid">
<a class="launch-card" href="/CRM/Users"><i>♚</i><div><h3>@(fa ? "کاربران و دسترسی‌ها" : "Users and access")</h3><p>@(fa ? "ایجاد کاربر، تعیین سمت و Role، فعال‌سازی، تغییر رمز و Unlock." : "Create users, assign roles, enable accounts, reset passwords and unlock.")</p></div><b>←</b></a>
<a class="launch-card" href="/CRM/Permissions"><i>⊞</i><div><h3>@(fa ? "ماتریس دسترسی" : "Permission matrix")</h3><p>@(fa ? "مرور سیاست Least Privilege و محدوده دسترسی نقش‌ها." : "Review least-privilege policies and role scopes.")</p></div><b>←</b></a>
<a class="launch-card" href="/CRM/SecurityCenter"><i>⛨</i><div><h3>@(fa ? "مرکز امنیت" : "Security center")</h3><p>@(fa ? "کنترل Login، Session، Lockout و وضعیت امنیت سازمان." : "Review login, sessions, lockout and security status.")</p></div><b>←</b></a>
<a class="launch-card" href="/CRM/AuditLog"><i>☷</i><div><h3>Audit Trail</h3><p>@(fa ? "ردیابی فعالیت‌های حساس و تغییرات مدیریتی." : "Review sensitive activity and administrative changes.")</p></div><b>←</b></a>
<a class="launch-card" href="/CRM/DataManagement"><i>◫</i><div><h3>@(fa ? "مدیریت داده" : "Data management")</h3><p>@(fa ? "Import، کیفیت داده، Deduplication و نگهداری." : "Import, data quality, deduplication and retention.")</p></div><b>←</b></a>
<a class="launch-card" href="/CRM/Integrations"><i>⌁</i><div><h3>Integration Hub</h3><p>@(fa ? "API Key، Webhook و اتصال سرویس‌های خارجی." : "API keys, webhooks and external services.")</p></div><b>←</b></a>
</div>
<div class="split-grid"><section class="panel"><div class="panel-head"><h2>@(fa ? "سلامت عملیات" : "Operations overview")</h2><span class="badge success">Live</span></div><div class="health-list"><div><span>@(fa ? "اتوماسیون‌های فعال" : "Active automations")</span><b>@ViewBag.Automations</b></div><div><span>@(fa ? "تیکت‌های باز" : "Open tickets")</span><b>@ViewBag.OpenTickets</b></div><div><span>Identity & RBAC</span><b>@(fa ? "فعال" : "Enabled")</b></div><div><span>SQL Identity Store</span><b>@(fa ? "متصل" : "Connected")</b></div></div></section><section class="panel"><div class="panel-head"><h2>@(fa ? "اقدامات پیشنهادی ادمین" : "Administrative actions")</h2></div><div class="action-stack"><a href="/CRM/Users">@(fa ? "تعریف کاربر و تعیین دسترسی" : "Create users and assign access")</a><a href="/CRM/SecurityCenter">@(fa ? "بازبینی حساب‌های قفل‌شده" : "Review locked accounts")</a><a href="/CRM/AuditLog">@(fa ? "مرور رخدادهای امنیتی" : "Review security events")</a><a href="/CRM/AiCopilot">@(fa ? "مشاهده تحلیل هوشمند CRM" : "Explore CRM insights")</a></div></section></div>
