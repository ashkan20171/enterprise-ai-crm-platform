@using System.Globalization
@{ var stage113English = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en"; }
@model IEnumerable<AshkanCRM.Models.NotificationItem>
@{ ViewData["Title"] = stage113English ? "Notifications" : "اعلان‌ها"; }
<div class="page-head"><div><span class="eyebrow">SMART INBOX</span><h1>@(stage113English ? "Notification Center" : "مرکز اعلان‌ها")</h1><p>@(stage113English ? "Role-based sales, SLA, and marketing alerts." : "هشدارهای فروش، SLA و بازاریابی بر اساس نقش کاربر.")</p></div><button class="ghost">@(stage113English ? "Mark All as Read" : "خواندن همه")</button></div>
<div class="notification-list">@foreach(var x in Model){<article class="notice @(x.IsRead?"":"unread")"><span class="notice-dot"></span><div><div class="row-between"><h3>@x.Title</h3><small>@x.Time</small></div><p>@x.Detail</p><span class="badge">@x.Audience</span></div></article>}</div>
