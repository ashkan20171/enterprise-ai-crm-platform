@model IEnumerable<AshkanCRM.Models.Customer>
@{ViewData["Title"] = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Customers" : "مشتریان";}
<div class="page-head"><div><p class="eyebrow" data-stage60-fa="نمای ۳۶۰ درجه مشتریان • SQL" data-stage60-en="Customer 360 • SQL">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Customer 360 • SQL" : "نمای ۳۶۰ درجه مشتریان • SQL")</p><h1 data-i18n="customers">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Customers" : "مشتریان")</h1><p data-i18n="customersDesc">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "A unified customer view backed by SQL Server" : "نمای یکپارچه مشتریان با ماندگاری واقعی در SQL Server")</p></div><div class="head-actions">@if(User.IsInRole("Admin")||User.IsInRole("SalesManager")){<a class="ghost" href="/CRM/CustomerRecycleBin" data-i18n="recycleBin">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Recycle bin" : "سطل بازیافت")</a>}<button class="primary" type="button" onclick="document.getElementById('newCustomer').showModal()" data-i18n="newCustomer">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "＋ New customer" : "＋ مشتری جدید")</button></div></div>
<form class="toolbar" method="get"><input name="q" value="@ViewBag.Query" data-i18n-placeholder="customerSearch" placeholder="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Search customers..." : "جستجوی مشتری...")"><select name="status"><option value="" data-stage58-code="All status">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "All statuses" : "همه وضعیت‌ها")</option><option value="Active" data-stage101-en="Active" data-stage101-fa="فعال">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Active" : "فعال")</option><option value="Prospect" data-stage101-en="Prospect" data-stage101-fa="مشتری بالقوه">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Prospect" : "مشتری بالقوه")</option><option value="Inactive" data-stage101-en="Inactive" data-stage101-fa="غیرفعال">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Inactive" : "غیرفعال")</option></select><button class="ghost" type="submit" data-i18n="searchBtn">جستجو</button><a class="ghost" href="/CRM/Customers" data-i18n="clearFilter">پاک کردن فیلتر</a></form>
<section class="panel"><div class="table-wrap"><table><thead><tr><th data-i18n="customer">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Customer" : "مشتری")</th><th data-i18n="company">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Company" : "شرکت")</th><th data-i18n="segment">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Segment" : "بخش")</th><th data-i18n="owner">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Owner" : "مسئول")</th><th data-i18n="score">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Score" : "امتیاز")</th><th data-i18n="status">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Status" : "وضعیت")</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><div class="person"><span class="avatar">@(string.IsNullOrEmpty(x.Name) ? "?" : x.Name.Substring(0,1))</span><span><b>@x.Name</b><small>@x.Email</small></span></div></td><td><a href="/CRM/CustomerTimeline/@x.Id"><b>@x.Company</b></a><small>@x.Phone</small></td><td><span class="badge">@x.Segment</span></td><td>@x.Owner</td><td><b class="score">@x.Score</b>/100</td><td><span class="status">● <span data-stage58-code="@x.Status">@x.Status</span></span></td><td><button class="ghost" type="button" onclick="document.getElementById('edit-@x.Id').showModal()" data-i18n="edit">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Edit" : "ویرایش")</button>@if(User.IsInRole("Admin")||User.IsInRole("SalesManager")){<form method="post" action="/CRM/DeleteCustomer" data-stage60-confirm="delete"><input type="hidden" name="id" value="@x.Id"/><button class="ghost danger" data-i18n="delete">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Delete" : "حذف")</button></form>}</td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="empty" data-i18n="noCustomers">مشتری‌ای یافت نشد.</td></tr>}</tbody></table></div></section>
@{ var total = (int)ViewBag.Total; var currentPage = (int)ViewBag.Page; var size = (int)ViewBag.PageSize; var pages = (int)Math.Ceiling(total / (double)size); }
<div class="pager"><small><span data-stage58-fa="رکورد" data-stage58-en="records">رکورد</span> @total</small><div>@if(currentPage>1){<a class="ghost" href="?q=@ViewBag.Query&status=@ViewBag.Status&page=@(currentPage-1)">‹</a>}<span class="chip">@currentPage / @Math.Max(1,pages)</span>@if(currentPage<pages){<a class="ghost" href="?q=@ViewBag.Query&status=@ViewBag.Status&page=@(currentPage+1)">›</a>}</div></div>
@foreach (var x in Model)
{
<dialog id="edit-@x.Id" class="crm-dialog"><form method="post" action="/CRM/UpdateCustomer">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"><div class="dialog-head"><b data-i18n="editCustomer">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Edit customer" : "ویرایش مشتری")</b><button type="button" class="icon-btn" onclick="this.closest('dialog').close()">×</button></div><div class="form-grid"><label><span data-i18n="name">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Name" : "نام")</span><input name="Name" value="@x.Name" required></label><label><span data-i18n="company">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Company" : "شرکت")</span><input name="Company" value="@x.Company" required></label><label><span data-stage60-fa="ایمیل" data-stage60-en="Email">ایمیل</span><input name="Email" value="@x.Email" type="email"></label><label><span data-i18n="phone">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Phone" : "تلفن")</span><input name="Phone" value="@x.Phone"></label><label><span data-i18n="segment">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Segment" : "بخش")</span><input name="Segment" value="@x.Segment"></label><label><span data-i18n="owner">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Owner" : "مسئول")</span><input name="Owner" value="@x.Owner"></label><label><span data-i18n="status">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Status" : "وضعیت")</span><input name="Status" value="@x.Status"></label><label><span data-i18n="score">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Score" : "امتیاز")</span><input name="Score" value="@x.Score" type="number" min="0" max="100"></label></div><div class="dialog-actions"><button type="button" class="ghost" onclick="this.closest('dialog').close()" data-i18n="cancel">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Cancel" : "انصراف")</button><button class="primary" data-i18n="save">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Save" : "ذخیره")</button></div></form></dialog>}
<dialog id="newCustomer" class="crm-dialog"><form method="post" action="/CRM/CreateCustomer">@Html.AntiForgeryToken()<div class="dialog-head"><div><b data-i18n="createCustomer">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Create customer" : "ایجاد مشتری")</b><small data-i18n="persistedInSql">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Saved directly to SQL Server" : "ذخیره مستقیم در SQL Server")</small></div><button type="button" class="icon-btn" onclick="this.closest('dialog').close()">×</button></div><div class="form-grid"><label><span data-i18n="name">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Name" : "نام")</span><input name="Name" required maxlength="120"></label><label><span data-i18n="company">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Company" : "شرکت")</span><input name="Company" required maxlength="160"></label><label><span data-stage60-fa="ایمیل" data-stage60-en="Email">ایمیل</span><input name="Email" type="email" autocomplete="email"></label><label><span data-i18n="phone">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Phone" : "تلفن")</span><input name="Phone"></label><label><span data-i18n="segment">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Segment" : "بخش")</span><select name="Segment"><option value="Enterprise" data-stage101-en="Enterprise" data-stage101-fa="سازمانی">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Enterprise" : "سازمانی")</option><option value="SMB" data-stage101-en="SMB" data-stage101-fa="کسب‌وکار کوچک و متوسط">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "SMB" : "کسب‌وکار کوچک و متوسط")</option><option value="Startup" data-stage101-en="Startup" data-stage101-fa="استارتاپ">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Startup" : "استارتاپ")</option></select></label><label><span data-i18n="owner">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Owner" : "مسئول")</span><input name="Owner" value="@User.Identity?.Name"></label><label><span data-i18n="status">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Status" : "وضعیت")</span><select name="Status"><option value="Active" data-stage101-en="Active" data-stage101-fa="فعال">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Active" : "فعال")</option><option value="Prospect" data-stage101-en="Prospect" data-stage101-fa="مشتری بالقوه">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Prospect" : "مشتری بالقوه")</option><option value="Inactive" data-stage101-en="Inactive" data-stage101-fa="غیرفعال">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Inactive" : "غیرفعال")</option></select></label><label><span data-i18n="score">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Score" : "امتیاز")</span><input name="Score" type="number" min="0" max="100" value="50"></label></div><div class="dialog-actions"><button type="button" class="ghost" onclick="this.closest('dialog').close()" data-i18n="cancel">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Cancel" : "انصراف")</button><button class="primary" type="submit" data-i18n="save">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Save" : "ذخیره")</button></div></form></dialog>
