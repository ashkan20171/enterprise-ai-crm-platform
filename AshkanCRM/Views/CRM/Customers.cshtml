@model IEnumerable<AshkanCRM.Models.Customer>
@{ViewData["Title"]="Customers";}
<div class="page-head"><div><p class="eyebrow">Customer 360 • SQL</p><h1 data-i18n="customers">مشتریان</h1><p data-i18n="customersDesc">نمای یکپارچه مشتریان با ماندگاری واقعی در SQL Server</p></div><div class="head-actions">@if(User.IsInRole("Admin")||User.IsInRole("SalesManager")){<a class="ghost" href="/CRM/CustomerRecycleBin" data-i18n="recycleBin">سطل بازیافت</a>}<button class="primary" type="button" onclick="document.getElementById('newCustomer').showModal()" data-i18n="newCustomer">＋ مشتری جدید</button></div></div>
<form class="toolbar" method="get"><input name="q" value="@ViewBag.Query" data-i18n-placeholder="customerSearch" placeholder="جستجوی مشتری..."><select name="status"><option value="">All status</option><option>Active</option><option>Prospect</option><option>Inactive</option></select><button class="ghost" type="submit" data-i18n="searchBtn">جستجو</button><a class="ghost" href="/CRM/Customers" data-i18n="clearFilter">پاک کردن فیلتر</a></form>
<section class="panel"><div class="table-wrap"><table><thead><tr><th data-i18n="customer">مشتری</th><th data-i18n="company">شرکت</th><th data-i18n="segment">بخش</th><th data-i18n="owner">مسئول</th><th data-i18n="score">امتیاز</th><th data-i18n="status">وضعیت</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><div class="person"><span class="avatar">@x.Name.Substring(0,1)</span><span><b>@x.Name</b><small>@x.Email</small></span></div></td><td><a href="/CRM/CustomerTimeline/@x.Id"><b>@x.Company</b></a><small>@x.Phone</small></td><td><span class="badge">@x.Segment</span></td><td>@x.Owner</td><td><b class="score">@x.Score</b>/100</td><td><span class="status">● @x.Status</span></td><td><button class="ghost" type="button" onclick="document.getElementById('edit-@x.Id').showModal()" data-i18n="edit">ویرایش</button>@if(User.IsInRole("Admin")||User.IsInRole("SalesManager")){<form method="post" action="/CRM/DeleteCustomer" onsubmit="return confirm('Delete / حذف؟')"><input type="hidden" name="id" value="@x.Id"/><button class="ghost danger" data-i18n="delete">حذف</button></form>}</td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="empty" data-i18n="noCustomers">مشتری‌ای یافت نشد.</td></tr>}</tbody></table></div></section>
@{ var total = (int)ViewBag.Total; var currentPage = (int)ViewBag.Page; var size = (int)ViewBag.PageSize; var pages = (int)Math.Ceiling(total / (double)size); }
<div class="pager"><small>@total records</small><div>@if(currentPage>1){<a class="ghost" href="?q=@ViewBag.Query&status=@ViewBag.Status&page=@(currentPage-1)">‹</a>}<span class="chip">@currentPage / @Math.Max(1,pages)</span>@if(currentPage<pages){<a class="ghost" href="?q=@ViewBag.Query&status=@ViewBag.Status&page=@(currentPage+1)">›</a>}</div></div>
@foreach (var x in Model)
{
<dialog id="edit-@x.Id" class="crm-dialog"><form method="post" action="/CRM/UpdateCustomer">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"><div class="dialog-head"><b data-i18n="editCustomer">ویرایش مشتری</b><button type="button" class="icon-btn" onclick="this.closest('dialog').close()">×</button></div><div class="form-grid"><label><span data-i18n="name">نام</span><input name="Name" value="@x.Name" required></label><label><span data-i18n="company">شرکت</span><input name="Company" value="@x.Company" required></label><label><span>Email</span><input name="Email" value="@x.Email" type="email"></label><label><span data-i18n="phone">تلفن</span><input name="Phone" value="@x.Phone"></label><label><span data-i18n="segment">بخش</span><input name="Segment" value="@x.Segment"></label><label><span data-i18n="owner">مسئول</span><input name="Owner" value="@x.Owner"></label><label><span data-i18n="status">وضعیت</span><input name="Status" value="@x.Status"></label><label><span data-i18n="score">امتیاز</span><input name="Score" value="@x.Score" type="number" min="0" max="100"></label></div><div class="dialog-actions"><button type="button" class="ghost" onclick="this.closest('dialog').close()" data-i18n="cancel">انصراف</button><button class="primary" data-i18n="save">ذخیره</button></div></form></dialog>}
<dialog id="newCustomer" class="crm-dialog"><form method="post" action="/CRM/CreateCustomer">@Html.AntiForgeryToken()<div class="dialog-head"><div><b data-i18n="createCustomer">ایجاد مشتری</b><small data-i18n="persistedInSql">ذخیره مستقیم در SQL Server</small></div><button type="button" class="icon-btn" onclick="this.closest('dialog').close()">×</button></div><div class="form-grid"><label><span data-i18n="name">نام</span><input name="Name" required maxlength="120"></label><label><span data-i18n="company">شرکت</span><input name="Company" required maxlength="160"></label><label><span>Email</span><input name="Email" type="email"></label><label><span data-i18n="phone">تلفن</span><input name="Phone"></label><label><span data-i18n="segment">بخش</span><select name="Segment"><option>Enterprise</option><option>SMB</option><option>Startup</option></select></label><label><span data-i18n="owner">مسئول</span><input name="Owner" value="@User.Identity?.Name"></label><label><span data-i18n="status">وضعیت</span><select name="Status"><option>Active</option><option>Prospect</option><option>Inactive</option></select></label><label><span data-i18n="score">امتیاز</span><input name="Score" type="number" min="0" max="100" value="50"></label></div><div class="dialog-actions"><button type="button" class="ghost" onclick="this.closest('dialog').close()" data-i18n="cancel">انصراف</button><button class="primary" type="submit" data-i18n="save">ذخیره</button></div></form></dialog>
