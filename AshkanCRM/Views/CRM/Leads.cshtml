@model IEnumerable<AshkanCRM.Models.Lead>
@{ ViewData["Title"] = "Leads"; }
<div class="page-head"><div><span class="eyebrow">LEAD INTELLIGENCE • SQL</span><h1 data-i18n="leads">سرنخ‌ها</h1><p data-i18n="leadsDesc">امتیازدهی، منبع جذب و پیگیری سرنخ‌های فروش.</p></div><button class="primary" type="button" onclick="document.getElementById('newLead').showModal()" data-i18n="newLead">＋ سرنخ جدید</button></div>
<div class="stats-grid"><article class="stat"><small data-i18n="totalLeads">کل سرنخ‌ها</small><strong>@Model.Count()</strong></article><article class="stat"><small data-i18n="qualifiedLeads">واجد شرایط</small><strong>@Model.Count(x=>x.Score>=80)</strong></article><article class="stat"><small data-i18n="avgScore">میانگین امتیاز</small><strong>@(Model.Any()?Math.Round(Model.Average(x=>x.Score)):0)</strong></article></div>
<div class="panel"><div class="table-wrap"><table><thead><tr><th data-i18n="name">نام</th><th data-i18n="company">شرکت</th><th data-i18n="source">منبع</th><th data-i18n="owner">مالک</th><th data-i18n="status">وضعیت</th><th data-i18n="score">امتیاز</th><th data-i18n="lastContact">آخرین تماس</th><th data-i18n="actions">عملیات</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Name</b></td><td>@x.Company</td><td>@x.Source</td><td>@x.Owner</td><td><span class="badge">@x.Status</span></td><td><span class="score">@x.Score</span></td><td>@x.LastContact</td><td><a class="ghost" href="/CRM/LeadTimeline/@x.Id" data-i18n="timeline">تاریخچه</a><button class="ghost" type="button" onclick="document.getElementById('editLead@x.Id').showModal()" data-i18n="edit">ویرایش</button></td></tr>}</tbody></table></div></div>
<dialog id="newLead" class="crm-dialog"><form method="post" action="/CRM/CreateLead">@Html.AntiForgeryToken()<div class="dialog-head"><b data-i18n="createLead">ایجاد سرنخ</b><button type="button" class="icon-btn" onclick="this.closest('dialog').close()">×</button></div><div class="form-grid"><label><span data-i18n="name">نام</span><input name="Name" required></label><label><span data-i18n="company">شرکت</span><input name="Company"></label><label><span data-i18n="source">منبع</span><input name="Source" value="Direct"></label><label><span data-i18n="owner">مالک</span><input name="Owner" value="@User.Identity?.Name"></label><label><span data-i18n="status">وضعیت</span><input name="Status" value="New"></label><label><span data-i18n="score">امتیاز</span><input name="Score" type="number" min="0" max="100" value="50"></label></div><div class="dialog-actions"><button type="button" class="ghost" onclick="this.closest('dialog').close()" data-i18n="cancel">انصراف</button><button class="primary" data-i18n="save">ذخیره</button></div></form></dialog>

@foreach(var x in Model){<dialog id="editLead@x.Id" class="crm-dialog"><form method="post" action="/CRM/UpdateLead">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"><div class="dialog-head"><b data-i18n="editLead">ویرایش سرنخ</b><button type="button" class="icon-btn" onclick="this.closest('dialog').close()">×</button></div><div class="form-grid"><label><span data-i18n="name">نام</span><input name="Name" value="@x.Name" required></label><label><span data-i18n="company">شرکت</span><input name="Company" value="@x.Company"></label><label><span data-i18n="source">منبع</span><input name="Source" value="@x.Source"></label><label><span data-i18n="owner">مالک</span><input name="Owner" value="@x.Owner"></label><label><span data-i18n="status">وضعیت</span><input name="Status" value="@x.Status"></label><label><span data-i18n="score">امتیاز</span><input name="Score" type="number" min="0" max="100" value="@x.Score"></label><label><span data-i18n="lastContact">آخرین تماس</span><input name="LastContact" value="@x.LastContact"></label></div><div class="dialog-actions"><button class="primary" data-i18n="save">ذخیره</button></div></form><form method="post" action="/CRM/DeleteLead" class="dialog-actions">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><button class="danger" data-i18n="delete">حذف</button></form></dialog>}
