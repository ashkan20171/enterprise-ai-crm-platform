@model IEnumerable<AshkanCRM.Models.UserAdminRow>
@using AshkanCRM.Models
@{ViewData["Title"]="کاربران و دسترسی‌ها"; var roles=(List<string>)ViewBag.Roles;}
<div class="page-head"><div><p class="eyebrow">IDENTITY & ACCESS MANAGEMENT</p><h1>کاربران و دسترسی‌ها</h1><p>ایجاد کاربر، تعیین سمت و سطح دسترسی، فعال‌سازی، رفع قفل و مدیریت رمز عبور.</p></div><button class="primary" onclick="document.getElementById('createUser').showModal()">＋ ایجاد کاربر</button></div>
@if(TempData["Success"]!=null){<div class="alert success">@TempData["Success"]</div>} @if(TempData["Error"]!=null){<div class="alert danger">@TempData["Error"]</div>}
<div class="grid-3"><div class="panel"><span class="eyebrow">TOTAL USERS</span><h2>@Model.Count()</h2><p>کاربران ثبت‌شده</p></div><div class="panel"><span class="eyebrow">ACTIVE</span><h2>@Model.Count(x=>x.IsActive)</h2><p>حساب فعال</p></div><div class="panel"><span class="eyebrow">LOCKED</span><h2>@Model.Count(x=>x.IsLocked)</h2><p>حساب قفل‌شده</p></div></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>کاربر</th><th>ایمیل</th><th>واحد</th><th>نقش / دسترسی</th><th>وضعیت</th><th>آخرین ورود</th><th>عملیات</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><div class="person"><span class="avatar">@x.Initials</span><b>@x.Name</b></div></td><td>@x.Email</td><td>@x.Department</td><td><span class="badge">@(x.Roles.FirstOrDefault()??"—")</span></td><td>@if(x.IsLocked){<span class="badge warn">قفل</span>}else if(x.IsActive){<span class="status">● فعال</span>}else{<span class="badge">غیرفعال</span>}</td><td>@(x.LastLoginAtUtc?.ToLocalTime().ToString("yyyy/MM/dd HH:mm")??"—")</td><td><details class="action-menu"><summary>مدیریت</summary><div class="action-pop"><form method="post" asp-action="UpdateUser"><input type="hidden" name="Id" value="@x.Id"><input name="Name" value="@x.Name" required><input name="Department" value="@x.Department"><select name="Role">@foreach(var r in roles){<option value="@r" selected="@(x.Roles.Contains(r))">@r</option>}</select><label><input type="checkbox" name="IsActive" value="true" checked="@x.IsActive"> فعال</label><button class="primary">ذخیره دسترسی</button></form><form method="post" asp-action="ResetUserPassword"><input type="hidden" name="id" value="@x.Id"><input name="newPassword" type="password" placeholder="رمز جدید" required><button class="ghost">تغییر رمز</button></form>@if(x.IsLocked){<form method="post" asp-action="UnlockUser"><input type="hidden" name="id" value="@x.Id"><button class="ghost">رفع قفل</button></form>}</div></details></td></tr>}</tbody></table></div></section>
<section class="panel"><div class="page-head"><div><h2>سطوح دسترسی استاندارد</h2><p>دسترسی صفحات سمت سرور نیز با Role کنترل می‌شود؛ مخفی‌کردن منو تنها لایه ظاهری نیست.</p></div><a class="ghost" href="/CRM/Permissions">مشاهده ماتریس کامل</a></div><div class="permission-grid"><div><b>Admin</b><span>مدیریت کامل، کاربران، امنیت، تنظیمات و داده</span></div><div><b>SalesManager</b><span>فروش، مشتری، Forecast و گزارش تیم</span></div><div><b>Sales</b><span>مشتری، Lead، Deal، Quote و فعالیت‌های فروش</span></div><div><b>Support</b><span>Ticket، SLA، دانش و فعالیت‌های پشتیبانی</span></div><div><b>Marketing</b><span>کمپین، Automation و فعالیت‌های بازاریابی</span></div></div></section>
<dialog id="createUser" class="crm-dialog"><form method="post" asp-action="CreateUser"><div class="dialog-head"><div><span class="eyebrow">NEW TEAM MEMBER</span><h2>ایجاد کاربر جدید</h2></div><button type="button" class="icon-btn" onclick="createUser.close()">×</button></div><label>نام و نام خانوادگی<input name="Name" required></label><label>ایمیل<input name="Email" type="email" required></label><label>واحد سازمانی<input name="Department"></label><label>رمز اولیه<input name="Password" type="password" minlength="8" required></label><label>نقش و سطح دسترسی<select name="Role">@foreach(var r in roles){<option value="@r">@r</option>}</select></label><label class="check-row"><input type="checkbox" name="IsActive" value="true" checked> حساب از ابتدا فعال باشد</label><div class="dialog-actions"><button type="button" class="ghost" onclick="createUser.close()">انصراف</button><button class="primary">ایجاد کاربر</button></div></form></dialog>
