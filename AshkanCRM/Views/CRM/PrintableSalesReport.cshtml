@model AshkanCRM.Models.PrintableSalesReportVm
@using System.Globalization
@{
 Layout = null;
 var en = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
 var title = en ? Model.TitleEn : Model.TitleFa;
 var headers = en ? Model.HeadersEn : Model.HeadersFa;
}
<!doctype html>
<html lang="@(en ? "en" : "fa")" dir="@(en ? "ltr" : "rtl")">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@title — AshkanCRM</title>
<style>
:root{color-scheme:light}*{box-sizing:border-box}body{margin:0;background:#f1f5f9;color:#172b4d;font-family:Tahoma,Arial,sans-serif;line-height:1.7}.sheet{max-width:1050px;margin:32px auto;padding:36px;background:white;box-shadow:0 12px 40px #1c365017;border-radius:16px}.brand{display:flex;justify-content:space-between;align-items:center;gap:20px;border-bottom:3px solid #138e86;padding-bottom:15px}.brand strong{font-size:24px;color:#0d716c}.meta{display:flex;gap:24px;flex-wrap:wrap;color:#475569;font-size:13px;margin:20px 0}h1{font-size:23px;margin:24px 0 4px}table{width:100%;border-collapse:collapse;font-size:13px;table-layout:auto}th,td{border:1px solid #dbe4ef;padding:10px 9px;text-align:start;overflow-wrap:anywhere}th{background:#e8f5f3;color:#125d59}tbody tr:nth-child(even){background:#f8fafc}.actions{max-width:1050px;margin:20px auto;display:flex;gap:10px}.actions button{border:0;background:#138e86;color:white;border-radius:9px;padding:10px 18px;cursor:pointer}.empty{padding:20px;text-align:center;color:#64748b}.foot{font-size:11px;color:#64748b;margin-top:24px;border-top:1px solid #e2e8f0;padding-top:12px}@@media print{@@page{size:A4 landscape;margin:12mm}body{background:white}.sheet{box-shadow:none;border-radius:0;max-width:none;margin:0;padding:0}.actions{display:none}thead{display:table-header-group}tr{break-inside:avoid}th{-webkit-print-color-adjust:exact;print-color-adjust:exact}}@@media(max-width:650px){.sheet{padding:14px;margin:8px;overflow-x:auto}.brand strong{font-size:19px}table{min-width:620px}}
</style></head>
<body><div class="actions"><button type="button" onclick="window.print()">@(en ? "Print / Save as PDF" : "چاپ / ذخیره به‌صورت PDF")</button></div>
<main class="sheet"><div class="brand"><strong>@Model.OrganizationName</strong><span>@(en ? "Management report" : "گزارش مدیریتی")</span></div>
<h1>@title</h1><div class="meta"><span>@(en ? "Period" : "بازه"): @Model.Months @(en ? "months" : "ماه")</span><span>@(en ? "Generated" : "تاریخ تهیه"): @Model.GeneratedAtLocal.ToString("yyyy-MM-dd HH:mm",CultureInfo.InvariantCulture) (@Model.TimeZoneId)</span>
<span>@(en ? "Reporting currency preference" : "واحد پول ترجیحی"): @Model.ReportingCurrency</span>
@if(!string.IsNullOrWhiteSpace(Model.Filter)){<span>@(en ? "Agent" : "کارشناس"): @Model.Filter</span>}</div>
@if(Model.Rows.Count == 0){<p class="empty">@(en ? "No data for this period." : "برای این بازه اطلاعاتی وجود ندارد.")</p>}
else {<table><thead><tr>@foreach(var header in headers){<th scope="col">@header</th>}</tr></thead><tbody>@foreach(var row in Model.Rows){<tr>@foreach(var cell in row){<td>@cell</td>}</tr>}</tbody></table>}
<p class="foot">@(en ? "Values reflect the selected reporting scope. Use your browser's Print dialog and choose Save as PDF." : "مقادیر مطابق محدوده دسترسی و فیلتر گزارش هستند. برای خروجی PDF از پنجره چاپ مرورگر گزینه ذخیره به‌صورت PDF را انتخاب کنید.")</p>
</main></body></html>
