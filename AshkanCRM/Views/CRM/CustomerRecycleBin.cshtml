@model IEnumerable<AshkanCRM.Models.CustomerEntity>
@{ViewData["Title"]="Customer Recycle Bin";}
<div class="page-head"><div><p class="eyebrow">Data lifecycle</p><h1 data-i18n="recycleBin">سطل بازیافت مشتریان</h1><p data-i18n="recycleDesc">بازیابی امن رکوردهای حذف‌شده بدون از دست رفتن تاریخچه.</p></div><a class="ghost" href="/CRM/Customers" data-i18n="backCustomers">بازگشت به مشتریان</a></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th data-i18n="customer">مشتری</th><th data-i18n="company">شرکت</th><th data-i18n="owner">مسئول</th><th data-i18n="updated">آخرین تغییر</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.Company</td><td>@x.Owner</td><td>@x.UpdatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td><form method="post" action="/CRM/RestoreCustomer"><input type="hidden" name="id" value="@x.Id"><button class="primary" data-i18n="restore">بازیابی</button></form></td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="empty" data-i18n="recycleEmpty">سطل بازیافت خالی است.</td></tr>}</tbody></table></div></section>
