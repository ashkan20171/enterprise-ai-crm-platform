@model IEnumerable<AshkanCRM.Models.LeadRoutingRuleEntity>
@{ ViewData["Title"]="Lead Routing"; }
<div class="page-head"><div><span class="eyebrow">AUTOMATION • SALES OPS</span><h1>Lead Routing</h1><p>Deterministic, auditable routing rules for new leads.</p></div></div>
<div class="split-grid"><form class="card form-grid" method="post" action="/CRM/CreateRoutingRule">@Html.AntiForgeryToken()<h3>New routing rule</h3><input name="Name" placeholder="Rule name" required><input name="Source" value="*" placeholder="Source"><input name="MinScore" type="number" min="0" max="100" value="70"><input name="AssignTo" placeholder="sales@example.com" required><input name="TeamKey" placeholder="sales-core"><input name="Priority" type="number" value="100"><button class="primary">Save rule</button></form><div class="card table-wrap"><table><thead><tr><th>Rule</th><th>Source</th><th>Min score</th><th>Assign to</th><th>Priority</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.Source</td><td>@x.MinScore</td><td>@x.AssignTo</td><td>@x.Priority</td></tr>}</tbody></table></div></div>
