@model IEnumerable<AshkanCRM.Models.Deal>
@{ViewData["Title"]="Revenue Intelligence"; var total=Model.Sum(x=>x.Value); var weighted=Model.Sum(x=>x.Value*x.Probability/100m);}
<div class="page-head"><div><span class="eyebrow">REVENUE INTELLIGENCE</span><h1>هوش درآمد و ریسک فروش</h1><p>Weighted pipeline، تمرکز ریسک و سیگنال‌های اقدام</p></div><button class="secondary">Export executive brief</button></div>
<div class="stats-grid"><div class="stat"><span>Total pipeline</span><b>@total.ToString("N0")</b><small>ریال</small></div><div class="stat"><span>Weighted pipeline</span><b>@weighted.ToString("N0")</b><small>بر اساس احتمال</small></div><div class="stat"><span>Win rate</span><b>31.4%</b><small>90 روز اخیر</small></div><div class="stat"><span>Sales velocity</span><b>28 روز</b><small>↓ 3 روز</small></div></div>
<div class="grid-2"><section class="panel"><h3>Deal risk radar</h3>@foreach(var d in Model.OrderBy(x=>x.Probability)){<div class="activity"><span class="activity-icon">◒</span><div><b>@d.Title</b><p>@d.Customer · @d.Value.ToString("N0") ریال</p><small>Confidence @d.Probability% · @d.Stage</small></div></div>}</section><section class="panel"><h3>AI-ready signals</h3><div class="insight"><b>⚡ Next best action</b><p>برای فرصت پارس داده جلسه تصمیم‌گیرنده را قبل از ارسال نسخه نهایی Quote ثبت کنید.</p></div><div class="insight"><b>◎ Concentration risk</b><p>بخش مهمی از Pipeline روی حساب‌های Enterprise متمرکز است؛ پوشش SMB را افزایش دهید.</p></div><div class="insight"><b>↗ Momentum</b><p>سرعت حرکت Leadهای Referral بهتر از Website است.</p></div></section></div>
