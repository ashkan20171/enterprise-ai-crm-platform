@model IEnumerable<AshkanCRM.Models.ActivityEntity>
@{ViewData["Title"]="Customer Timeline"; var c=(AshkanCRM.Models.CustomerEntity)ViewBag.Customer;}
<div class="page-head"><div><p class="eyebrow">Customer 360 • SQL timeline</p><h1>@c.Company</h1><p>@c.Name · @c.Email · @c.Owner</p></div><a class="ghost" href="/CRM/Customers" data-i18n="backCustomers">بازگشت به مشتریان</a></div>
<div class="kpi-grid"><article class="kpi"><small data-i18n="score">امتیاز</small><strong>@c.Score</strong></article><article class="kpi"><small data-i18n="status">وضعیت</small><strong>@c.Status</strong></article><article class="kpi"><small data-i18n="segment">بخش</small><strong>@c.Segment</strong></article></div>
<section class="panel"><div class="panel-title"><div><b data-i18n="activityTimeline">تاریخچه فعالیت</b><small data-i18n="activityTimelineDesc">رویدادهای ثبت‌شده سمت سرور برای این مشتری</small></div></div><div class="timeline">@foreach(var x in Model){<div class="timeline-item"><span class="timeline-dot"></span><div><b>@x.Subject</b><p>@x.Detail</p><small>@x.Type · @x.Owner · @x.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></div></div>}@if(!Model.Any()){<div class="empty" data-i18n="noActivity">هنوز فعالیتی ثبت نشده است.</div>}</div></section>
