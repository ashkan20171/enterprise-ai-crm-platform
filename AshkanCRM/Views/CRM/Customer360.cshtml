@model AshkanCRM.Models.Customer
@using AshkanCRM.Models
@{ ViewData["Title"]="Customer 360"; var deals=(List<Deal>)ViewBag.Deals; var contacts=(List<ContactItem>)ViewBag.Contacts; var notes=(List<NoteItem>)ViewBag.Notes; }
<div class="page-head"><div><span class="eyebrow">CUSTOMER 360</span><h1>@Model.Company</h1><p>@Model.Name · @Model.Segment · امتیاز سلامت @Model.Score/100</p></div><div class="head-actions"><button class="secondary">ارسال ایمیل</button><button class="primary">＋ ثبت فعالیت</button></div></div>
<div class="stats-grid"><div class="stat"><span>Health score</span><b>@Model.Score</b><small>وضعیت @Model.Status</small></div><div class="stat"><span>ارزش فرصت‌ها</span><b>@deals.Sum(x=>x.Value).ToString("N0")</b><small>ریال</small></div><div class="stat"><span>مخاطبین</span><b>@contacts.Count</b><small>تصمیم‌گیرندگان</small></div><div class="stat"><span>Owner</span><b>@Model.Owner</b><small>Account owner</small></div></div>
<div class="grid-2"><section class="panel"><div class="panel-title"><div><h3>مخاطبین و ذی‌نفعان</h3><p>Relationship map</p></div></div>@foreach(var c in contacts){<div class="activity"><span class="avatar">@c.Name[..1]</span><div><b>@c.Name @if(c.Primary){<em class="badge good">اصلی</em>}</b><p>@c.JobTitle · @c.Email · @c.Phone</p></div></div>}</section><section class="panel"><div class="panel-title"><div><h3>یادداشت‌های تیم</h3><p>Shared account intelligence</p></div></div>@foreach(var n in notes){<div class="activity"><span class="activity-icon">✎</span><div><b>@n.Author <em class="badge">@n.Visibility</em></b><p>@n.Body</p><small>@n.Time</small></div></div>}</section></div>
<section class="panel"><div class="panel-title"><div><h3>فرصت‌های مرتبط</h3><p>Revenue history & open pipeline</p></div></div><div class="table-wrap"><table><thead><tr><th>فرصت</th><th>مرحله</th><th>ارزش</th><th>احتمال</th><th>تاریخ بستن</th></tr></thead><tbody>@foreach(var d in deals){<tr><td><b>@d.Title</b></td><td><span class="badge">@d.Stage</span></td><td>@d.Value.ToString("N0")</td><td>@d.Probability%</td><td>@d.CloseDate</td></tr>}</tbody></table></div></section>
