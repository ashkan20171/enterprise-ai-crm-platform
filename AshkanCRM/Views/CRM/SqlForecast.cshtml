@model IEnumerable<AshkanCRM.Models.DealEntity>
@{ViewData["Title"]="Forecast";decimal target=(decimal)ViewBag.Target;decimal won=(decimal)ViewBag.Won;var attainment=target<=0?0:Math.Min(999,(int)Math.Round(won/target*100));}
<div class="page-head"><div><span class="eyebrow">REVENUE FORECAST • TARGETS</span><h1>Forecast</h1><p data-i18n="forecastSqlDesc">پیش‌بینی درآمد و تحقق هدف بر اساس Dealهای واقعی SQL.</p></div><button class="primary" onclick="document.getElementById('targetDlg').showModal()">＋ Sales target</button></div>
<div class="stats"><article><small>Pipeline</small><strong>@(((decimal)ViewBag.Pipeline).ToString("N0"))</strong></article><article><small>Weighted</small><strong>@(((decimal)ViewBag.Weighted).ToString("N0"))</strong></article><article><small>Won</small><strong>@won.ToString("N0")</strong></article><article><small>Target</small><strong>@target.ToString("N0")</strong><span class="badge">@attainment%</span></article></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Deal</th><th data-i18n="customer">مشتری</th><th>Stage</th><th>Value</th><th>Probability</th><th>Weighted</th></tr></thead><tbody>@foreach(var x in Model.OrderByDescending(x=>x.Value)){<tr><td><b>@x.Title</b></td><td>@x.Customer</td><td><span class="badge">@x.Stage</span></td><td>@x.Value.ToString("N0")</td><td>@x.Probability%</td><td>@((x.Value*x.Probability/100m).ToString("N0"))</td></tr>}</tbody></table></div></section>
<dialog id="targetDlg" class="crm-dialog"><form method="post" action="/CRM/SaveSalesTarget">@Html.AntiForgeryToken()<div class="dialog-head"><b>Sales target</b><button type="button" class="icon-btn" onclick="this.closest('dialog').close()">×</button></div><div class="form-grid"><label>Owner<input name="owner" value="sales@ashkancrm.local" required></label><label>Year<input name="year" type="number" value="@DateTime.UtcNow.Year"></label><label>Month<input name="month" type="number" min="1" max="12" value="@DateTime.UtcNow.Month"></label><label>Target<input name="targetAmount" type="number" min="0"></label><label>Stretch<input name="stretchAmount" type="number" min="0"></label></div><div class="dialog-actions"><button class="primary">Save</button></div></form></dialog>
