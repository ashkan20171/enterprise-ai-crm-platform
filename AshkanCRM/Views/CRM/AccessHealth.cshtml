@model IEnumerable<AshkanCRM.Models.UserPermissionGrant>
@using System.Globalization
@{ var fa = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa"; ViewData["Title"] = fa ? "سلامت دسترسی" : "Access health"; }
<div class="page-head"><div><span class="eyebrow">ADMIN / ZERO TRUST</span><h1>@(fa ? "سلامت دسترسی" : "Access health")</h1><p>@(fa ? "بازبینی چرخه عمر کاربران، مجوزهای پرریسک و کنترل‌های حداقل دسترسی." : "Review user lifecycle, high-risk grants and least-privilege controls.")</p></div><a class="primary" href="/CRM/AccessStudio">@(fa ? "بازبینی دسترسی" : "Review access")</a></div>
<div class="stats-grid"><div class="stat"><span>@(fa ? "کل کاربران" : "Total users")</span><b>@ViewBag.Total</b><small>Identity accounts</small></div><div class="stat"><span>@(fa ? "غیرفعال" : "Inactive")</span><b>@ViewBag.Inactive</b><small>Disabled accounts</small></div><div class="stat"><span>@(fa ? "قفل‌شده" : "Locked")</span><b>@ViewBag.Locked</b><small>Security review</small></div><div class="stat"><span>@(fa ? "کاربران بدون ورود اخیر" : "No recent login")</span><b>@ViewBag.NoRecentLogin</b><small>30+ days</small></div></div>
<div class="grid-2"><section class="panel"><div class="panel-title"><h2>@(fa ? "مجوزهای پرریسک" : "High-risk grants")</h2><span class="badge">@ViewBag.HighRisk</span></div><div class="table-wrap"><table><thead><tr><th>@(fa ? "کاربر" : "User")</th><th>@(fa ? "بخش" : "Module")</th><th>@(fa ? "حذف" : "Delete")</th><th>@(fa ? "تایید" : "Approve")</th><th>@(fa ? "محدوده" : "Scope")</th></tr></thead><tbody>@foreach(var x in Model.Where(x=>x.Delete||x.Approve||x.Scope=="All")){<tr><td>@x.UserEmail</td><td>@x.Module</td><td>@(x.Delete?"✓":"—")</td><td>@(x.Approve?"✓":"—")</td><td>@x.Scope</td></tr>}</tbody></table></div></section><section class="panel"><div class="panel-title"><h2>@(fa ? "کنترل‌های پیشنهادی" : "Recommended controls")</h2><span class="badge success">Zero Trust</span></div><div class="activity"><span class="activity-icon">1</span><div><b>@(fa ? "بازبینی دوره‌ای نقش‌ها و مجوزها" : "Review roles and grants regularly")</b><p>@(fa ? "مجوزهای Delete، Approve و All Scope را به‌صورت دوره‌ای بررسی کنید." : "Periodically review Delete, Approve and All Scope grants.")</p></div></div><div class="activity"><span class="activity-icon">2</span><div><b>@(fa ? "چرخه عمر کاربران" : "User lifecycle")</b><p>@(fa ? "حساب‌های غیرفعال، قفل‌شده و بدون ورود اخیر را بررسی کنید." : "Review inactive, locked and dormant accounts.")</p></div></div><div class="activity"><span class="activity-icon">3</span><div><b>Separation of Duties</b><p>@(fa ? "در عملیات حساس، درخواست‌کننده و تاییدکننده یک نفر نباشند." : "For sensitive operations, separate requester and approver.")</p></div></div></section></div>
