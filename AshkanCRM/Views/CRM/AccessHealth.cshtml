@model IEnumerable<AshkanCRM.Models.UserPermissionGrant>
@{ ViewData["Title"]="سلامت دسترسی"; }
<div class="page-head"><div><span class="eyebrow">ADMIN / ZERO TRUST</span><h1>سلامت دسترسی</h1><p>بازبینی چرخه عمر کاربران، مجوزهای پرریسک و کنترل‌های حداقل دسترسی.</p></div><a class="primary" href="/CRM/AccessStudio">بازبینی دسترسی</a></div>
<div class="stats-grid"><div class="stat"><span>کل کاربران</span><b>@ViewBag.Total</b><small>Identity accounts</small></div><div class="stat"><span>غیرفعال</span><b>@ViewBag.Inactive</b><small>Disabled accounts</small></div><div class="stat"><span>قفل‌شده</span><b>@ViewBag.Locked</b><small>Security review</small></div><div class="stat"><span>کاربران بدون ورود اخیر</span><b>@ViewBag.NoRecentLogin</b><small>30+ days</small></div></div>
<div class="grid-2"><section class="panel"><div class="panel-title"><h2>مجوزهای پرریسک</h2><span class="badge">@ViewBag.HighRisk</span></div><div class="table-wrap"><table><thead><tr><th>کاربر</th><th>بخش</th><th>حذف</th><th>تایید</th><th>محدوده</th></tr></thead><tbody>@foreach(var x in Model.Where(x=>x.Delete||x.Approve||x.Scope=="All")){<tr><td>@x.UserEmail</td><td>@x.Module</td><td>@(x.Delete?"✓":"—")</td><td>@(x.Approve?"✓":"—")</td><td>@x.Scope</td></tr>}</tbody></table></div></section><section class="panel"><div class="panel-title"><h2>کنترل‌های پیشنهادی</h2><span class="badge success">Zero Trust</span></div><div class="activity"><span class="activity-icon">1</span><div><b>بازبینی دوره‌ای نقش‌ها و مجوزها</b><p>مجوزهای Delete، Approve و All Scope را به‌صورت دوره‌ای بررسی کنید.</p></div></div><div class="activity"><span class="activity-icon">2</span><div><b>چرخه عمر کاربران</b><p>حساب‌های غیرفعال، قفل‌شده و بدون ورود اخیر را بررسی کنید.</p></div></div><div class="activity"><span class="activity-icon">3</span><div><b>Separation of Duties</b><p>در عملیات حساس، درخواست‌کننده و تاییدکننده یک نفر نباشند.</p></div></div></section></div>
