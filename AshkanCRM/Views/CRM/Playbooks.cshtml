@model IEnumerable<AshkanCRM.Models.PlaybookItem>
@{ ViewData["Title"]="Playbooks"; }
<div class="page-head"><div><span class="eyebrow">REVENUE ENABLEMENT</span><h1>Playbookهای عملیاتی</h1><p>فرآیندهای استاندارد فروش، پشتیبانی و بازاریابی را به راهنمای اجرایی قابل اندازه‌گیری تبدیل کنید.</p></div><button class="primary">＋ Playbook جدید</button></div>
<div class="panel"><div class="table-wrap"><table><thead><tr><th>نام</th><th>ماژول</th><th>Trigger</th><th>مراحل</th><th>مالک</th><th>وضعیت</th><th>Adoption</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Name</b></td><td>@x.Module</td><td>@x.Trigger</td><td>@x.Steps</td><td>@x.Owner</td><td>@x.Status</td><td><b>@x.Adoption%</b></td></tr>}</tbody></table></div></div>
