@{ ViewData["Title"]="Duplicate Detection"; var cg=(IEnumerable<List<AshkanCRM.Models.CustomerEntity>>)ViewBag.CustomerGroups; var lg=(IEnumerable<List<AshkanCRM.Models.LeadEntity>>)ViewBag.LeadGroups; }
<div class="page-head"><div><span class="eyebrow">DATA QUALITY</span><h1>Duplicate Detection</h1><p>شناسایی رکوردهای تکراری با Email مشتری و ترکیب Name + Company سرنخ.</p></div></div>
<div class="grid-2"><section class="panel"><div class="panel-title"><h3>Customer duplicates</h3><span class="badge">@cg.Count() گروه</span></div>@foreach(var g in cg){<div class="activity"><div><b>@g.First().Email</b><p>@string.Join(" · ",g.Select(x=>x.Company+" #"+x.Id))</p></div></div>}@if(!cg.Any()){<div class="empty">مورد تکراری پیدا نشد.</div>}</section><section class="panel"><div class="panel-title"><h3>Lead duplicates</h3><span class="badge">@lg.Count() گروه</span></div>@foreach(var g in lg){<div class="activity"><div><b>@g.First().Name · @g.First().Company</b><p>@string.Join(" · ",g.Select(x=>"#"+x.Id+" "+x.Owner))</p></div></div>}@if(!lg.Any()){<div class="empty">مورد تکراری پیدا نشد.</div>}</section></div>
