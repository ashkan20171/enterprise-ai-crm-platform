@model IEnumerable<AshkanCRM.Models.AuditItem>
@using System.Globalization
@{ var fa = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa"; ViewData["Title"] = fa ? "گزارش ممیزی" : "Audit log"; }
<div class="page-head"><div><span class="eyebrow">SECURITY & GOVERNANCE</span><h1>Audit Log</h1><p>@(fa ? "ردیابی فعالیت‌های حساس کاربران برای امنیت و پاسخ‌گویی." : "Track sensitive user activity for security and accountability.")</p></div><span class="badge">@(fa ? "گزارش ممیزی" : "Audit log")</span></div>
<div class="panel"><div class="table-wrap"><table><thead><tr><th>@(fa ? "کاربر" : "User")</th><th>@(fa ? "عملیات" : "Action")</th><th>@(fa ? "موجودیت" : "Entity")</th><th>@(fa ? "جزئیات" : "Details")</th><th>@(fa ? "زمان" : "Time")</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.User</b></td><td><span class="badge">@x.Action</span></td><td>@x.Entity</td><td>@x.Detail</td><td>@x.Time</td></tr>}@if (!Model.Any()) { <tr><td colspan="5">@(fa ? "رویدادی ثبت نشده است." : "No audit events recorded.")</td></tr> }</tbody></table></div></div>
