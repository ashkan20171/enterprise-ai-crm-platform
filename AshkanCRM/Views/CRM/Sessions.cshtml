@model IEnumerable<AshkanCRM.Models.SessionItem>
@using System.Globalization
@{
    var en = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    ViewData["Title"] = en ? "User sessions" : "نشست‌های کاربران";
}
<div class="page-head"><div>
    <span class="eyebrow">@(en ? "SECURITY / SESSIONS" : "امنیت / نشست‌ها")</span>
    <h1>@(en ? "User sessions" : "نشست‌های کاربران")</h1>
    <p>@(en ? "Review device, location, IP address and recent activity for recorded sign-in sessions." : "دستگاه، موقعیت، نشانی IP و آخرین فعالیت نشست‌های ثبت‌شده را برای بررسی امنیتی مشاهده کنید.")</p>
</div></div>
<div class="panel"><div class="table-wrap"><table>
    <thead><tr><th>@(en ? "User" : "کاربر")</th><th>@(en ? "Device" : "دستگاه")</th><th>@(en ? "Location" : "موقعیت")</th><th>IP</th><th>@(en ? "Last activity" : "آخرین فعالیت")</th><th>@(en ? "Status" : "وضعیت")</th></tr></thead>
    <tbody>
    @if (Model != null && Model.Any()) {
        foreach (var x in Model) {
            <tr><td><b>@x.User</b></td><td>@x.Device</td><td>@x.Location</td><td><code>@x.Ip</code></td><td>@x.LastActive</td><td><span class="badge success">@x.Status</span></td></tr>
        }
    } else {
        <tr><td colspan="6" class="muted">@(en ? "No sessions to display." : "نشستی برای نمایش وجود ندارد.")</td></tr>
    }
    </tbody>
</table></div></div>
