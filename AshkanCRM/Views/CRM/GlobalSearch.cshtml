@model AshkanCRM.Models.GlobalSearchVm
@{ViewData["Title"]="جستجوی سراسری";}
<div class="page-head"><div><span class="eyebrow">GLOBAL SEARCH</span><h1 data-i18n="globalSearch">جستجوی سراسری</h1><p data-i18n="globalSearchDesc">جستجوی Permission-aware در مشتریان، سرنخ‌ها و فرصت‌های فروش.</p></div></div>
<form class="panel search-hero" method="get"><div class="global-search"><span>⌕</span><input name="q" value="@ViewBag.Query" placeholder="Search..." autofocus/><button class="primary" data-i18n="searchBtn">جستجو</button></div></form>
@if(!string.IsNullOrWhiteSpace((string?)ViewBag.Query)){<div class="search-results-grid"><section class="panel"><h3 data-i18n="customers">مشتریان</h3>@foreach(var x in Model.Customers){<a class="search-result" href="/CRM/CustomerTimeline/@x.Id"><b>@x.Name</b><span>@x.Company · @x.Email</span></a>}@if(!Model.Customers.Any()){<p class="muted">—</p>}</section><section class="panel"><h3 data-i18n="leads">سرنخ‌ها</h3>@foreach(var x in Model.Leads){<a class="search-result" href="/CRM/LeadTimeline/@x.Id"><b>@x.Name</b><span>@x.Company · @x.Status</span></a>}@if(!Model.Leads.Any()){<p class="muted">—</p>}</section><section class="panel"><h3 data-i18n="deals">فرصت‌های فروش</h3>@foreach(var x in Model.Deals){<a class="search-result" href="/CRM/DealTimeline/@x.Id"><b>@x.Title</b><span>@x.Customer · @x.Stage</span></a>}@if(!Model.Deals.Any()){<p class="muted">—</p>}</section></div>}
