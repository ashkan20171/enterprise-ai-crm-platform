@model IEnumerable<AshkanCRM.Models.Deal>
@{ ViewData["Title"]="Executive Cockpit"; }
<div class="page-head"><div><span class="eyebrow">EXECUTIVE INTELLIGENCE</span><h1>کاکپیت مدیریتی</h1><p>نمای فشرده از درآمد، ریسک، فروش، سرنخ‌ها و پشتیبانی برای تصمیم‌گیری مدیریتی.</p></div><a class="primary" href="/CRM/Reports">گزارش‌های کامل</a></div>
<div class="kpi-grid"><div class="kpi"><small>Pipeline</small><strong>@(((decimal)ViewBag.Pipeline).ToString("N0"))</strong></div><div class="kpi"><small>Weighted Pipeline</small><strong>@(((decimal)ViewBag.Weighted).ToString("N0"))</strong></div><div class="kpi"><small>Hot Leads</small><strong>@ViewBag.HotLeads</strong></div><div class="kpi"><small>Open Tickets</small><strong>@ViewBag.OpenTickets</strong></div></div>
<div class="panel"><div class="panel-head"><div><h3>Top revenue opportunities</h3><p>فرصت‌های با ارزش بالاتر برای تمرکز مدیریتی.</p></div></div><div class="table-wrap"><table><thead><tr><th>فرصت</th><th>مشتری</th><th>مالک</th><th>ارزش</th><th>احتمال</th></tr></thead><tbody>@foreach(var d in Model.OrderByDescending(x=>x.Value).Take(5)){<tr><td><b>@d.Title</b></td><td>@d.Customer</td><td>@d.Owner</td><td>@d.Value.ToString("N0")</td><td>@d.Probability%</td></tr>}</tbody></table></div></div>
