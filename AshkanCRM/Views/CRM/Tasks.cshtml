@model IEnumerable<AshkanCRM.Models.CrmTaskEntity>
@{ ViewData["Title"]="کارها و یادآورها"; var open=Model.Count(x=>x.Status!="Done"); var overdue=Model.Count(x=>x.Status!="Done"&&x.DueAtUtc<DateTime.UtcNow); }
<div class="page-head"><div><p class="eyebrow">PRODUCTIVITY CORE</p><h1 data-i18n="tasks">کارها و یادآورها</h1><p data-i18n="tasksSqlDesc">وظایف پایدار، سررسیدها و Reminderهای متصل به SQL Server.</p></div><button class="primary" onclick="document.getElementById('taskDlg').showModal()">＋ <span data-i18n="newTask">کار جدید</span></button></div>
<div class="stats compact"><article><small data-i18n="openTasks">باز</small><strong>@open</strong></article><article><small data-i18n="overdue">عقب‌افتاده</small><strong>@overdue</strong></article><article><small data-i18n="today">امروز</small><strong>@Model.Count(x=>x.DueAtUtc.Date==DateTime.UtcNow.Date)</strong></article><article><small data-i18n="completed">تکمیل‌شده</small><strong>@Model.Count(x=>x.Status=="Done")</strong></article></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th data-i18n="task">کار</th><th data-i18n="type">نوع</th><th data-i18n="owner">مسئول</th><th data-i18n="priority">اولویت</th><th data-i18n="due">سررسید</th><th data-i18n="status">وضعیت</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Title</b><small class="muted">@x.Description</small></td><td><span class="badge">@x.Type</span></td><td>@x.Assignee</td><td>@x.Priority</td><td>@x.DueAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td><span class="status">@x.Status</span></td><td><div class="row-actions"><form method="post" action="/CRM/ToggleTask">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="ghost">@(x.Status=="Done"?"↶":"✓")</button></form><form method="post" action="/CRM/DeleteTask">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="ghost">×</button></form></div></td></tr>}</tbody></table></div></section>
<dialog id="taskDlg" class="crm-dialog"><form method="post" action="/CRM/CreateTask">@Html.AntiForgeryToken()<div class="dialog-head"><div><h3 data-i18n="newTask">کار جدید</h3><small data-i18n="taskPersisted">ذخیره در SQL Server</small></div><button type="button" class="ghost" onclick="taskDlg.close()">×</button></div><div class="form-grid"><label><span data-i18n="task">کار</span><input name="Title" required maxlength="240"/></label><label><span data-i18n="type">نوع</span><select name="Type"><option>FollowUp</option><option>Call</option><option>Meeting</option><option>Email</option></select></label><label><span data-i18n="owner">مسئول</span><input name="Assignee" value="@User.Identity?.Name"/></label><label><span data-i18n="priority">اولویت</span><select name="Priority"><option>Medium</option><option>High</option><option>Low</option></select></label><label><span data-i18n="due">سررسید</span><input type="datetime-local" name="DueAtUtc" required/></label><label><span data-i18n="reminder">یادآور</span><input type="datetime-local" name="ReminderAtUtc"/></label><label><span>تکرارشونده</span><select name="IsRecurring"><option value="false">خیر</option><option value="true">بله</option></select></label><label><span>تناوب</span><select name="Recurrence"><option>None</option><option>Daily</option><option>Weekly</option><option>Monthly</option></select></label><label class="span-2"><span data-i18n="description">توضیحات</span><textarea name="Description"></textarea></label></div><div class="dialog-actions"><button type="button" class="ghost" onclick="taskDlg.close()" data-i18n="cancel">انصراف</button><button class="primary" data-i18n="save">ذخیره</button></div></form></dialog>
