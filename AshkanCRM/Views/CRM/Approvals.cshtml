@model IEnumerable<AshkanCRM.Models.ApprovalItem>
@{ ViewData["Title"]="تاییدیه‌ها"; }
<div class="page-head"><div><span class="eyebrow">GOVERNANCE</span><h1>مرکز تاییدیه‌ها</h1><p>تخفیف‌ها، تغییر مالکیت، عملیات حساس و درخواست‌های امنیتی را با کنترل مدیریتی بررسی کنید.</p></div></div>
<div class="grid cards-4"><div class="stat-card"><span>در انتظار</span><b>@Model.Count(x=>x.Status=="در انتظار")</b><small>نیازمند تصمیم</small></div><div class="stat-card"><span>تایید شده</span><b>@Model.Count(x=>x.Status=="تایید شده")</b><small>Workflow history</small></div><div class="stat-card"><span>اولویت بالا</span><b>@Model.Count(x=>x.Priority=="بالا")</b><small>Attention required</small></div><div class="stat-card"><span>Policy</span><b>2-step</b><small>برای عملیات حساس</small></div></div>
<div class="panel"><div class="table-wrap"><table><thead><tr><th>درخواست</th><th>نوع</th><th>درخواست‌کننده</th><th>تاییدکننده</th><th>زمان</th><th>وضعیت</th><th>اقدام</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Title</b></td><td>@x.Type</td><td>@x.RequestedBy</td><td>@x.Approver</td><td>@x.Created</td><td><span class="badge">@x.Status</span></td><td><button class="ghost">بررسی</button></td></tr>}</tbody></table></div></div>
