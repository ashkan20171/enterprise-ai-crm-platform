@model IEnumerable<AshkanCRM.Models.Deal>
@{ ViewData["Title"] = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Deals" : "فرصت‌های فروش"; var stages=new[]{"Qualification","Proposal","Negotiation","Won","Lost"}; }
<div class="page-head"><div><p class="eyebrow" data-stage60-fa="قیف فروش • SQL • کشیدن و رهاکردن" data-stage60-en="SALES PIPELINE • SQL • DRAG & DROP">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "SALES PIPELINE • SQL • DRAG & DROP" : "قیف فروش • SQL • کشیدن و رهاکردن")</p><h1 data-i18n="deals">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Deals" : "فرصت‌های فروش")</h1><p data-i18n="dealsDesc">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Drag deals between pipeline stages; every change is recorded in the audit log and timeline." : "فرصت‌ها را بکشید و بین مراحل فروش جابه‌جا کنید؛ هر تغییر در Audit و Timeline ثبت می‌شود.")</p></div><button class="primary" type="button" onclick="document.getElementById('newDeal').showModal()" data-i18n="newDeal">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "＋ New deal" : "＋ فرصت جدید")</button></div>
<form id="stageToken" hidden>@Html.AntiForgeryToken()</form>
<div class="kanban" id="dealBoard">@foreach(var stage in stages){<section class="kanban-col" data-stage="@stage"><header><b data-stage58-code="@stage">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? stage : stage == "Qualification" ? "ارزیابی" : stage == "Proposal" ? "پیشنهاد" : stage == "Negotiation" ? "مذاکره" : stage == "Won" ? "موفق" : "ناموفق")</b><span>@Model.Count(x=>x.Stage==stage)</span></header><div class="kanban-drop">@foreach(var x in Model.Where(x=>x.Stage==stage)){<article class="deal-card" draggable="true" data-id="@x.Id"><span class="badge">@x.Probability%</span><h3>@x.Title</h3><p>@x.Customer</p><strong>@x.Value.ToString("N0")</strong><footer><span>♙ @x.Owner</span><span>◷ @x.CloseDate</span></footer><div class="card-actions"><a class="ghost" href="/CRM/DealTimeline/@x.Id" data-i18n="timeline">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Timeline" : "تاریخچه")</a><button class="ghost" type="button" onclick="document.getElementById('editDeal@x.Id').showModal()" data-i18n="edit">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Edit" : "ویرایش")</button></div></article>}</div></section>}</div>
<dialog id="newDeal" class="crm-dialog"><form method="post" action="/CRM/CreateDeal">@Html.AntiForgeryToken()<div class="dialog-head"><b data-i18n="createDeal">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Create deal" : "ایجاد فرصت")</b><button type="button" class="icon-btn" onclick="this.closest('dialog').close()">×</button></div><div class="form-grid"><label><span data-i18n="title">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Title" : "عنوان")</span><input name="Title" required></label><label><span data-i18n="customer">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Customer" : "مشتری")</span><input name="Customer"></label><label><span data-i18n="owner">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Owner" : "مالک")</span><input name="Owner" value="@User.Identity?.Name"></label><label><span data-i18n="value">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Value" : "ارزش")</span><input name="Value" type="number" min="0"></label><label><span data-i18n="stage">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Stage" : "مرحله")</span><select name="Stage">@foreach(var st in stages){<option value="@st" data-stage58-code="@st">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? st : st == "Qualification" ? "ارزیابی" : st == "Proposal" ? "پیشنهاد" : st == "Negotiation" ? "مذاکره" : st == "Won" ? "موفق" : "ناموفق")</option>}</select></label><label><span data-i18n="probability">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Probability" : "احتمال")</span><input name="Probability" type="number" min="0" max="100" value="20"></label><label><span data-i18n="closeDate">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Planned close date" : "تاریخ بستن")</span><input name="CloseDate"></label></div><div class="dialog-actions"><button type="button" class="ghost" onclick="this.closest('dialog').close()" data-i18n="cancel">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Cancel" : "انصراف")</button><button class="primary" data-i18n="save">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Save" : "ذخیره")</button></div></form></dialog>
@foreach(var x in Model){<dialog id="editDeal@x.Id" class="crm-dialog"><form method="post" action="/CRM/UpdateDeal">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@x.Id"><div class="dialog-head"><b data-i18n="editDeal">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Edit deal" : "ویرایش فرصت")</b><button type="button" class="icon-btn" onclick="this.closest('dialog').close()">×</button></div><div class="form-grid"><label><span data-i18n="title">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Title" : "عنوان")</span><input name="Title" value="@x.Title" required></label><label><span data-i18n="customer">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Customer" : "مشتری")</span><input name="Customer" value="@x.Customer"></label><label><span data-i18n="owner">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Owner" : "مالک")</span><input name="Owner" value="@x.Owner"></label><label><span data-i18n="value">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Value" : "ارزش")</span><input name="Value" type="number" value="@x.Value"></label><label><span data-i18n="stage">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Stage" : "مرحله")</span><select name="Stage">@foreach(var st in stages){<option value="@st" data-stage58-code="@st" selected="@(st==x.Stage)">@st</option>}</select></label><label><span data-i18n="probability">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Probability" : "احتمال")</span><input name="Probability" type="number" min="0" max="100" value="@x.Probability"></label><label><span data-i18n="closeDate">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Planned close date" : "تاریخ بستن")</span><input name="CloseDate" value="@x.CloseDate"></label></div><div class="dialog-actions"><button class="primary" data-i18n="save">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Save" : "ذخیره")</button></div></form><form method="post" action="/CRM/DeleteDeal" class="dialog-actions">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><button class="danger" data-i18n="delete">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "Delete" : "حذف")</button></form></dialog>}
<script>
(()=>{let dragged=null;document.querySelectorAll('.deal-card[draggable=true]').forEach(c=>c.addEventListener('dragstart',()=>dragged=c));document.querySelectorAll('.kanban-col').forEach(col=>{col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',()=>col.classList.remove('drag-over'));col.addEventListener('drop',async e=>{e.preventDefault();col.classList.remove('drag-over');if(!dragged)return;const fd=new FormData();fd.append('id',dragged.dataset.id);fd.append('stage',col.dataset.stage);fd.append('__RequestVerificationToken',document.querySelector('#stageToken input').value);const r=await fetch('/CRM/MoveDealStage',{method:'POST',body:fd});if(r.ok)location.reload();});});})();
</script>

<script>if(location.hash==="#newDeal")window.addEventListener("DOMContentLoaded",()=>document.getElementById("newDeal")?.showModal());</script>
