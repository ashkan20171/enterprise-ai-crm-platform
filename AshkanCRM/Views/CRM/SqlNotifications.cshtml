@using System.Globalization
@{ var stage113English = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en"; }
@model IEnumerable<AshkanCRM.Models.NotificationEntity>
@{ ViewData["Title"] = stage113English ? "Notifications" : "اعلان‌ها"; }
<div class="page-head"><div><span class="eyebrow">PERSISTENT NOTIFICATION CENTER</span><h1 data-i18n="notifications">@(stage113English ? "Notifications" : "اعلان‌ها")</h1><p data-i18n="notificationDesc">@(stage113English ? "Persistent notifications generated by CRM events." : "اعلان‌های پایدار و مبتنی بر رویدادهای CRM.")</p></div></div>
<div class="panel">@if(!Model.Any()){<p class="muted" data-i18n="noNotifications">@(stage113English ? "No new notifications." : "اعلان جدیدی وجود ندارد.")</p>}@foreach(var n in Model){<article class="notification-row @(n.IsRead?"":"unread")"><div><span class="badge">@n.Type</span><b>@n.Title</b><p>@n.Message</p><small>@n.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></div>@if(!n.IsRead){<form method="post" action="/CRM/MarkNotificationRead">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@n.Id"><button class="ghost" data-i18n="markRead">@(stage113English ? "Mark as Read" : "خوانده شد")</button></form>}</article>}</div>
