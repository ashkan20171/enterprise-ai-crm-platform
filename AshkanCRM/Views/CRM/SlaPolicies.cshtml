@using System.Globalization
@{ var stage113English = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en"; }
@model IEnumerable<AshkanCRM.Models.SlaPolicyItem>
@{ ViewData["Title"] = stage113English ? "SLA Policies" : "سیاست‌های SLA"; }
<div class="page-head"><div><span class="eyebrow">SERVICE OPERATIONS</span><h1>@(stage113English ? "SLA Policies" : "سیاست‌های SLA")</h1><p>@(stage113English ? "Manage response, resolution, and escalation times for different customer groups." : "زمان پاسخ، حل و Escalation را برای گروه‌های مختلف مشتری کنترل کنید.")</p></div><button class="primary">@(stage113English ? "＋ New Policy" : "＋ سیاست جدید")</button></div>
<div class="panel"><div class="table-wrap"><table><thead><tr><th>@(stage113English ? "Name" : "نام")</th><th>@(stage113English ? "Applies To" : "اعمال روی")</th><th>@(stage113English ? "First Response" : "پاسخ اولیه")</th><th>@(stage113English ? "Resolution" : "حل")</th><th>Escalation</th><th>@(stage113English ? "Status" : "وضعیت")</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Name</b></td><td>@x.AppliesTo</td><td>@x.FirstResponse</td><td>@x.Resolution</td><td>@x.Escalation</td><td><span class="badge success">@x.Status</span></td></tr>}</tbody></table></div></div>
