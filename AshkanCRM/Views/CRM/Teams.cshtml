@model IEnumerable<AshkanCRM.Models.CrmTeamEntity>
@using AshkanCRM.Models.Identity
@{ ViewData["Title"]="تیم‌ها و Scope دسترسی"; var members=(IEnumerable<AshkanCRM.Models.CrmTeamMemberEntity>)ViewBag.Members; var users=(IEnumerable<ApplicationUser>)ViewBag.Users; }
<div class="page-head"><div><span class="eyebrow">ADMIN / ORGANIZATION</span><h1>Team Ownership & Access Scope</h1><p>تفکیک Role از Data Scope با مدل Own / Team / All.</p></div><button class="primary" onclick="teamDlg.showModal()">＋ ایجاد تیم</button></div>
<div class="stats compact"><article><small>تیم‌های فعال</small><strong>@Model.Count(x=>x.IsActive)</strong></article><article><small>عضویت‌ها</small><strong>@members.Count()</strong></article><article><small>Team Scope</small><strong>@members.Count(x=>x.AccessScope=="Team")</strong></article><article><small>All Scope</small><strong>@members.Count(x=>x.AccessScope=="All")</strong></article></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>تیم</th><th>Department</th><th>Manager</th><th>اعضا / Scope</th><th></th></tr></thead><tbody>@foreach(var t in Model){<tr><td><b>@t.Name</b><small class="muted">@t.TeamKey</small></td><td>@t.Department</td><td>@t.ManagerUserName</td><td>@foreach(var m in members.Where(x=>x.TeamId==t.Id)){<span class="badge">@m.UserName · @m.AccessScope</span>}</td><td><button class="ghost" onclick="document.getElementById('member-@t.Id').showModal()">＋ عضو</button></td></tr>}</tbody></table></div></section>
<dialog id="teamDlg" class="crm-dialog"><form method="post" action="/CRM/CreateTeam">@Html.AntiForgeryToken()<div class="dialog-head"><h3>ایجاد تیم</h3><button type="button" class="ghost" onclick="teamDlg.close()">×</button></div><div class="form-grid"><label>Team key<input name="teamKey" required placeholder="enterprise-sales"/></label><label>نام<input name="name" required/></label><label>واحد<input name="department" value="Sales"/></label><label>مدیر<select name="managerUserName"><option value="">—</option>@foreach(var u in users){<option value="@u.UserName">@u.DisplayName · @u.UserName</option>}</select></label></div><div class="dialog-actions"><button class="primary">ذخیره</button></div></form></dialog>
@foreach(var t in Model){<dialog id="member-@t.Id" class="crm-dialog"><form method="post" action="/CRM/AddTeamMember">@Html.AntiForgeryToken()<input type="hidden" name="teamId" value="@t.Id"/><div class="dialog-head"><h3>عضویت در @t.Name</h3><button type="button" class="ghost" onclick="this.closest('dialog').close()">×</button></div><div class="form-grid"><label>کاربر<select name="userName" required>@foreach(var u in users){<option value="@u.UserName">@u.DisplayName · @u.UserName</option>}</select></label><label>Data Scope<select name="accessScope"><option>Own</option><option>Team</option><option>All</option></select></label></div><div class="dialog-actions"><button class="primary">اعمال دسترسی</button></div></form></dialog>}
