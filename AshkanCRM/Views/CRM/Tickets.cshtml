@model IEnumerable<AshkanCRM.Models.Ticket>
@{ViewData["Title"]="پشتیبانی";}<div class="page-head"><div><p class="eyebrow">Service Desk</p><h1 data-i18n="tickets">مرکز پشتیبانی</h1><p>SLA، صف تیکت‌ها و رضایت مشتری را کنترل کنید.</p></div><button class="primary">＋ تیکت جدید</button></div><div class="stats compact"><article><small>باز</small><strong>12</strong></article><article><small>SLA در خطر</small><strong>3</strong></article><article><small>میانگین پاسخ</small><strong>18m</strong></article><article><small>CSAT</small><strong>94%</strong></article></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>#</th><th>موضوع</th><th>مشتری</th><th>اولویت</th><th>وضعیت</th><th>کارشناس</th><th>بروزرسانی</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Id</td><td><b>@x.Subject</b></td><td>@x.Customer</td><td><span class="badge">@x.Priority</span></td><td><span class="status">@x.Status</span></td><td>@x.Assignee</td><td>@x.Updated</td></tr>}</tbody></table></div></section>