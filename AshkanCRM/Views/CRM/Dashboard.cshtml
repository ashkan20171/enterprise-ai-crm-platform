@model IEnumerable<AshkanCRM.Models.Deal>
@{ViewData["Title"]="داشبورد";}<div class="hero-row"><div><p class="eyebrow" data-i18n="overview">نمای کلی کسب‌وکار</p><h1><span data-i18n="hello">سلام</span>، @User.Identity?.Name 👋</h1><p data-i18n="dashboardSub">امروز فرصت خوبی برای پیشبرد فروش و ساختن رابطه‌های بهتر است.</p></div><button class="primary">＋ <span data-i18n="newDeal">فرصت جدید</span></button></div><div class="stats"><article><span class="stat-icon">♙</span><small data-i18n="activeCustomers">مشتریان فعال</small><strong>@ViewBag.Customers</strong><em>↑ 12.4%</em></article><article><span class="stat-icon">◇</span><small data-i18n="pipeline">ارزش پایپ‌لاین</small><strong>@(((decimal)ViewBag.Pipeline/1000000000).ToString("0.0"))B</strong><em>↑ 8.2%</em></article><article><span class="stat-icon">✓</span><small data-i18n="won">فروش موفق</small><strong>@(((decimal)ViewBag.Won/1000000).ToString("0"))M</strong><em>این ماه</em></article><article><span class="stat-icon">◷</span><small data-i18n="openTasks">کارهای باز</small><strong>@ViewBag.Tasks</strong><em>3 فوری</em></article></div><div class="grid-2"><section class="panel"><div class="panel-head"><div><h2 data-i18n="salesTrend">روند فروش</h2><p>۶ ماه اخیر</p></div><span class="success-pill">+18.6%</span></div><div class="chart"><div class="y-labels"><span>2B</span><span>1.5B</span><span>1B</span><span>500M</span><span>0</span></div><svg viewBox="0 0 600 210" preserveAspectRatio="none"><defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6d5dfc" stop-opacity=".28"/><stop offset="1" stop-color="#6d5dfc" stop-opacity="0"/></linearGradient></defs><path class="area" d="M0 180 C70 160 85 125 145 140 S240 95 300 110 S380 55 430 80 S520 45 600 30 L600 210 L0 210Z"/><path class="line" d="M0 180 C70 160 85 125 145 140 S240 95 300 110 S380 55 430 80 S520 45 600 30"/></svg><div class="months"><span>فروردین</span><span>اردیبهشت</span><span>خرداد</span><span>تیر</span><span>مرداد</span><span>شهریور</span></div></div></section><section class="panel"><div class="panel-head"><div><h2 data-i18n="pipelineStage">پایپ‌لاین فروش</h2><p data-i18n="byStage">بر اساس مرحله</p></div><a href="/CRM/Deals">مشاهده همه</a></div><div class="funnel"><div style="--w:92%"><b>مذاکره</b><span>1.85B</span></div><div style="--w:75%"><b>پیشنهاد</b><span>980M</span></div><div style="--w:58%"><b>بررسی</b><span>420M</span></div><div style="--w:44%"><b>برنده</b><span>760M</span></div></div></section></div><section class="panel"><div class="panel-head"><div><h2 data-i18n="recentDeals">فرصت‌های اخیر</h2><p data-i18n="recentDealsSub">آخرین تغییرات تیم فروش</p></div><a href="/CRM/Deals" data-i18n="viewAll">مشاهده همه</a></div><div class="table-wrap"><table><thead><tr><th>عنوان</th><th>مشتری</th><th>مسئول</th><th>ارزش</th><th>مرحله</th><th>احتمال</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Title</b></td><td>@x.Customer</td><td>@x.Owner</td><td>@x.Value.ToString("N0")</td><td><span class="badge">@x.Stage</span></td><td><div class="prob"><i style="width:@(x.Probability)%"></i></div> @x.Probability%</td></tr>}</tbody></table></div></section>