@using System.Globalization
@{ var fa = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa"; }
@model IEnumerable<AshkanCRM.Models.UserPermissionGrant>
@{ ViewData["Title"] = fa ? "استودیو دسترسی" : "Access Studio"; }
<div class="page-head"><div><p class="eyebrow">ZERO TRUST • FINE-GRAINED RBAC</p><h1>@(fa ? "استودیو دسترسی کاربران" : "User Access Studio")</h1><p>@(fa ? "مجوزهای هر کاربر را بر اساس عملیات و دامنه داده مدیریت کنید." : "Manage permissions by action and data scope for each user.")</p></div><a class="primary" href="/CRM/Users">@(fa ? "＋ تعریف کاربر" : "+ Add user")</a></div>
<div class="stats compact"><article><small>@(fa ? "مدل دسترسی" : "Access model")</small><strong>Role + User</strong><em>Fine-grained</em></article><article><small>@(fa ? "دامنه داده" : "Data scope")</small><strong>Own / Team / All</strong><em>Scope-aware</em></article><article><small>@(fa ? "اصل امنیتی" : "Security principle")</small><strong>Least Privilege</strong><em>Default deny</em></article><article><small>@(fa ? "بازبینی" : "Review")</small><strong>@(fa ? "دوره‌ای" : "Periodic")</strong><em>Access review</em></article></div>
<div class="panel"><div class="panel-head"><div><h2>@(fa ? "مجوزهای اختصاصی کاربران" : "User-specific permissions")</h2><p>@(fa ? "نقش پایه حفظ می‌شود و این لایه برای استثناهای کنترل‌شده است." : "The base role is preserved; this layer handles controlled exceptions.")</p></div></div><div class="table-wrap"><table><thead><tr><th>@(fa ? "کاربر" : "User")</th><th>@(fa ? "ماژول" : "Module")</th><th>View</th><th>Create</th><th>Edit</th><th>Delete</th><th>Export</th><th>Approve</th><th>Scope</th><th>@(fa ? "عملیات" : "Actions")</th></tr></thead><tbody>@foreach(var x in Model){<tr><form method="post" action="/CRM/SavePermission"><input type="hidden" name="id" value="@x.Id"/><td><b>@x.UserEmail</b><small>@x.UpdatedBy • @x.UpdatedAt</small></td><td>@x.Module</td><td><input type="checkbox" name="view" value="true" checked="@x.View"/></td><td><input type="checkbox" name="create" value="true" checked="@x.Create"/></td><td><input type="checkbox" name="edit" value="true" checked="@x.Edit"/></td><td><input type="checkbox" name="delete" value="true" checked="@x.Delete"/></td><td><input type="checkbox" name="export" value="true" checked="@x.Export"/></td><td><input type="checkbox" name="approve" value="true" checked="@x.Approve"/></td><td><select name="scope"><option selected="@(x.Scope=="Own")">Own</option><option selected="@(x.Scope=="Team")">Team</option><option selected="@(x.Scope=="All")">All</option></select></td><td><button class="chip" type="submit">@(fa ? "ذخیره" : "Save")</button></td></form></tr>}</tbody></table></div></div>
<div class="grid-2"><div class="panel"><h2>@(fa ? "بازبینی دسترسی" : "Access review")</h2><p class="muted">@(fa ? "کاربران غیرفعال، مجوزهای حساس و دسترسی‌های گسترده را به‌صورت دوره‌ای بررسی کنید." : "Periodically review inactive users, sensitive grants and broad access.")</p><div class="callout">@(fa ? "برای شناسایی مجوزهای پرخطر باید داده‌های واقعی دسترسی بررسی شوند." : "Inspect actual permission data to identify high-risk grants.")</div></div><div class="panel"><h2>@(fa ? "تفکیک وظایف" : "Separation of duties")</h2><p class="muted">@(fa ? "در عملیات حساس، درخواست‌کننده و تأییدکننده می‌توانند افراد متفاوتی باشند." : "Sensitive actions can separate the requester from the approver.")</p><div class="callout">@(fa ? "مجوز تأیید مستقل از ویرایش قابل تعریف است." : "Approval can be configured independently of editing.")</div></div></div>
