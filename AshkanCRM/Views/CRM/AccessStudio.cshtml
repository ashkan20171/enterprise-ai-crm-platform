@model IEnumerable<AshkanCRM.Models.UserPermissionGrant>
@{ ViewData["Title"]="استودیو دسترسی"; }
<div class="page-head"><div><p class="eyebrow">ZERO TRUST • FINE-GRAINED RBAC</p><h1>استودیو دسترسی کاربران</h1><p>مجوزهای View/Create/Edit/Delete/Export/Approve را برای هر کاربر و دامنه داده کنترل کنید.</p></div><a class="primary" href="/CRM/Users">＋ تعریف کاربر</a></div>
<div class="stats compact"><article><small>مدل دسترسی</small><strong>Role + User</strong><em>Fine-grained</em></article><article><small>دامنه داده</small><strong>Own / Team / All</strong><em>Scope-aware</em></article><article><small>اصل امنیتی</small><strong>Least Privilege</strong><em>Default deny</em></article><article><small>بازبینی</small><strong>دوره‌ای</strong><em>Access review</em></article></div>
<div class="panel"><div class="panel-head"><div><h2>مجوزهای اختصاصی کاربران</h2><p>Role پایه حفظ می‌شود و این لایه برای استثناهای کنترل‌شده است.</p></div></div><div class="table-wrap"><table><thead><tr><th>کاربر</th><th>ماژول</th><th>View</th><th>Create</th><th>Edit</th><th>Delete</th><th>Export</th><th>Approve</th><th>Scope</th><th>عملیات</th></tr></thead><tbody>@foreach(var x in Model){<tr><form method="post" action="/CRM/SavePermission"><input type="hidden" name="id" value="@x.Id"/><td><b>@x.UserEmail</b><small>@x.UpdatedBy • @x.UpdatedAt</small></td><td>@x.Module</td><td><input type="checkbox" name="view" value="true" checked="@x.View"/></td><td><input type="checkbox" name="create" value="true" checked="@x.Create"/></td><td><input type="checkbox" name="edit" value="true" checked="@x.Edit"/></td><td><input type="checkbox" name="delete" value="true" checked="@x.Delete"/></td><td><input type="checkbox" name="export" value="true" checked="@x.Export"/></td><td><input type="checkbox" name="approve" value="true" checked="@x.Approve"/></td><td><select name="scope"><option selected="@(x.Scope=="Own")">Own</option><option selected="@(x.Scope=="Team")">Team</option><option selected="@(x.Scope=="All")">All</option></select></td><td><button class="chip" type="submit">ذخیره</button></td></form></tr>}</tbody></table></div></div>
<div class="grid-2"><div class="panel"><h2>Access Review</h2><p class="muted">کاربران بدون فعالیت، مجوزهای حساس و دسترسی‌های گسترده را به‌صورت دوره‌ای بازبینی کنید.</p><div class="callout">⚠ دو مجوز Export برای بازبینی دوره‌ای علامت‌گذاری شده‌اند.</div></div><div class="panel"><h2>Separation of Duties</h2><p class="muted">برای عملیات حساس، ایجادکننده و تأییدکننده می‌توانند افراد متفاوت باشند.</p><div class="callout">✓ Approval روی Deal/Quote مستقل از Edit قابل کنترل است.</div></div></div>
