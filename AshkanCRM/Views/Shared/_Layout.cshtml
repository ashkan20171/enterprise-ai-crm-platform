age="Products">◆ <span>محصولات</span></a>}<a href="/CRM/Tasks" data-page="Tasks">✓ <span data-i18n="tasks">کارها</span></a><a href="/CRM/Activities" data-page="Activities">◌ <span>فعالیت‌ها</span></a><a href="/CRM/Calendar" data-page="Calendar">▣ <span>تقویم</span></a><a href="/CRM/Knowledge" data-page="Knowledge">▧ <span>پایگاه دانش</span></a>@if(User.IsInRole("Admin")||User.IsInRole("SalesManager")||User.IsInRole("Support")||User.IsInRole("Marketing")){<a href="/CRM/Playbooks" data-page="Playbooks">▤ <span>Playbookهای عملیاتی</span></a>}<a href="/CRM/Notifications" data-page="Notifications">♢ <span>اعلان‌ها</span></a>@if(User.IsInRole("Admin")||User.IsInRole("Support")){<a href="/CRM/Tickets" data-page="Tickets">◉ <span data-i18n="tickets">پشتیبانی</span></a><a href="/CRM/SlaPolicies" data-page="SlaPolicies">◷ <span>سیاست‌های SLA</span></a>}@if(User.IsInRole("Admin")||User.IsInRole("Marketing")){<a href="/CRM/Marketing" data-page="Marketing">✦ <span data-i18n="marketing">بازاریابی</span></a>}@if(User.IsInRole("Admin")||User.IsInRole("SalesManager")){<a href="/CRM/Reports" data-page="Reports">▥ <span data-i18n="reports">گزارش‌ها و تحلیل</span></a><a href="/CRM/ExecutiveCockpit" data-page="ExecutiveCockpit">◫ <span>کاکپیت مدیریتی</span></a><a href="/CRM/Approvals" data-page="Approvals">✓ <span>تاییدیه‌ها</span></a><a href="/CRM/Forecast" data-page="Forecast">◒ <span>Forecast</span></a><a href="/CRM/RevenueIntelligence" data-page="RevenueIntelligence">↗ <span>هوش درآمد</span></a><a href="/CRM/WinLossAnalytics" data-page="WinLossAnalytics">◒ <span>Win/Loss Analytics</span></a>}@if(User.IsInRole("Admin")||User.IsInRole("SalesManager")||User.IsInRole("Marketing")||User.IsInRole("Support")){<a href="/CRM/Automations" data-page="Automations">⚡ <span>اتوماسیون</span></a>}@if(User.IsInRole("Admin")){<span class="nav-label" data-i18n="admin">مدیریت ادمین</span><a href="/CRM/AdminHub" data-page="AdminHub">▦ <span>داشبورد ادمین</span></a><a href="/CRM/DashboardBuilder" data-page="DashboardBuilder">▥ <span>سازنده داشبورد</span></a><a href="/CRM/Users" data-page="Users">♚ <span data-i18n="users">کاربران و دسترسی‌ها</span></a><a href="/CRM/Teams" data-page="Teams">♟ <span>تیم‌ها و واحدها</span></a><a href="/CRM/Sessions" data-page="Sessions">◉ <span>نشست‌های کاربران</span></a><a href="/CRM/FeatureFlags" data-page="FeatureFlags">⚑ <span>Feature Flags</span></a><a href="/CRM/AccessStudio" data-page="AccessStudio">🔑 <span>استودیو دسترسی کاربران</span></a><a href="/CRM/AccessHealth" data-page="AccessHealth"><span class="nav-icon">◉</span><span>سلامت دسترسی</span></a><a href="/CRM/Permissions" data-page="Permissions">⊞ <span>ماتریس دسترسی</span></a><a href="/CRM/SecurityCenter" data-page="SecurityCenter">⛨ <span>مرکز امنیت</span></a><a href="/CRM/SecurityOperations" data-page="SecurityOperations">◉ <span>Security Operations</span></a><a href="/CRM/LeadRouting" data-page="LeadRouting">↯ <span>Lead Routing</span></a><a href="/CRM/DataGovernance" data-page="DataGovernance">▣ <span>Data Governance</span></a><a href="/CRM/DataManagement" data-page="DataManagement">◫ <span>مدیریت داده</span></a><a href="/CRM/DataCore" data-page="DataCore">▣ <span data-i18n="dataCore">هسته داده سازمانی</span></a><a href="/CRM/CustomerRecycleBin" data-page="CustomerRecycleBin">♲ <span data-i18n="recycleBin">سطل بازیافت</span></a><a href="/CRM/DataQuality" data-page="DataQuality">◇ <span>کیفیت داده</span></a><a href="/CRM/DuplicateDetection" data-page="DuplicateDetection">≋ <span>Duplicate Detection</span></a><a href="/CRM/Integrations" data-page="Integrations">⌁ <span>Integration Hub</span></a><a href="/CRM/IntegrationMonitor" data-page="IntegrationMonitor">◌ <span>Integration Monitor</span></a><a href="/CRM/AuditLog" data-page="AuditLog">☷ <span>Audit Log</span></a><a href="/CRM/Settings" data-page="Settings">⚙ <span data-i18n="settings">تنظیمات</span></a>}</nav><div class="sidebar-foot"><div class="mini-profile"><span class="avatar">@(User.FindFirst("Initials")?.Value