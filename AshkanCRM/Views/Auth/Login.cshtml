@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AshkanCRM.SharedResource> L
@{ Layout = null; var en = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en"; }
<!doctype html><html lang="@(en ? "en" : "fa")" dir="@(en ? "ltr" : "rtl")"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@L["LoginTitle"] | Ashkan CRM</title><link rel="stylesheet" href="/css/crm.css"></head><body class="auth-body"><section class="auth-art"><a class="brand light"><span class="brand-mark">A</span><span><b>Ashkan CRM</b><small>Customer Intelligence Platform</small></span></a><div class="auth-copy"><span class="auth-pill">@L["LoginPill"]</span><h1>@L["LoginHero"]<br><em>@L["LoginHeroEm"]</em></h1><p>@L["LoginDescription"]</p><div class="auth-metrics"><span><b>360°</b><small>@L["CustomerView"]</small></span><span><b>24/7</b><small>@L["SecureAccess"]</small></span><span><b>100%</b><small>@L["AccessControl"]</small></span></div></div><div class="orb one"></div><div class="orb two"></div></section><section class="auth-form-wrap"><div class="auth-form"><div class="lang-auth"><button type="button" data-lang-toggle>@(en ? "FA" : "EN")</button></div><p class="eyebrow">@L["Welcome"]</p><h2>@L["LoginTitle"]</h2><p>@L["LoginHelp"]</p>@if(ViewBag.Error!=null){<div class="alert" role="alert">@ViewBag.Error</div>}<form method="post">@Html.AntiForgeryToken()<label>@L["WorkEmail"]<input name="email" type="email" autocomplete="username" placeholder="name@company.com" required></label><label>@L["Password"]<input name="password" type="password" autocomplete="current-password" placeholder="••••••••" required></label><div class="form-row"><label class="check"><input name="remember" type="checkbox" value="true"> @L["Remember"]</label><span>@L["ForgotPassword"]</span></div><button class="primary full" type="submit">@L["SignIn"]</button></form><div class="demo-box"><b>@L["DemoAccounts"]</b><code>admin@ashkancrm.local / Admin123!</code><code>sales@ashkancrm.local / Sales123!</code><code>support@ashkancrm.local / Support123!</code></div><p class="auth-bottom">@L["NoAccount"] <a href="/Auth/Register">@L["RegisterLink"]</a></p></div></section><script src="/js/stage105-culture-switch.js"></script><script src="/js/crm.js"></script></body></html>