@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AshkanCRM.SharedResource> L
@{ Layout = null; var en = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en"; }
<!doctype html><html lang="@(en ? "en" : "fa")" dir="@(en ? "ltr" : "rtl")"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@L["DeniedTitle"] | Ashkan CRM</title><link rel="stylesheet" href="/css/crm.css"></head><body class="center-page"><div class="denied"><span>🔒</span><h1>@L["DeniedTitle"]</h1><p>@L["DeniedDescription"]</p><a class="primary" href="/CRM/Dashboard">@L["BackDashboard"]</a></div><script src="/js/stage105-culture-switch.js"></script><script src="/js/crm.js"></script></body></html>