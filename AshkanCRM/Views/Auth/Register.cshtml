@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AshkanCRM.SharedResource> L
@{ Layout = null; var en = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en"; }
<!doctype html><html lang="@(en ? "en" : "fa")" dir="@(en ? "ltr" : "rtl")"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@L["RegisterTitle"] | Ashkan CRM</title><link rel="stylesheet" href="/css/crm.css"></head><body class="auth-body"><section class="auth-art register-art"><a class="brand light"><span class="brand-mark">A</span><span><b>Ashkan CRM</b><small>Enterprise CRM</small></span></a><div class="auth-copy"><span class="auth-pill">@L["RegisterPill"]</span><h1>@L["RegisterHero"]<br><em>@L["RegisterHeroEm"]</em></h1><p>@L["RegisterDescription"]</p></div></section><section class="auth-form-wrap"><div class="auth-form"><div class="lang-auth"><button type="button" data-lang-toggle>@(en ? "FA" : "EN")</button></div><p class="eyebrow">@L["GetStarted"]</p><h2>@L["RegisterTitle"]</h2>@if(ViewBag.Error!=null){<div class="alert" role="alert">@ViewBag.Error</div>}@if(ViewBag.Success!=null){<div class="success-box" role="status">✓ @ViewBag.Success</div>}<form method="post">@Html.AntiForgeryToken()<label>@L["FullName"]<input name="name" autocomplete="name" required placeholder="@L["FullNamePlaceholder"]"></label><label>@L["WorkEmail"]<input name="email" type="email" autocomplete="email" required placeholder="name@company.com"></label><label>@L["Company"]<input name="company" required placeholder="@L["CompanyPlaceholder"]"></label><button class="primary full" type="submit">@L["SubmitRequest"]</button></form><p class="auth-bottom">@L["AlreadyMember"] <a href="/Auth/Login">@L["LoginLink"]</a></p></div></section><script src="/js/stage105-culture-switch.js"></script><script src="/js/crm.js"></script></body></html>