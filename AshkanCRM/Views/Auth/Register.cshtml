@{Layout=null;}<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ثبت نام | Ashkan CRM</title><link rel="stylesheet" href="/css/crm.css"></head><body class="auth-body"><section class="auth-art register-art"><a class="brand light"><span class="brand-mark">A</span><span><b>Ashkan CRM</b><small>Enterprise CRM</small></span></a><div class="auth-copy"><span class="auth-pill">امن • منعطف • نقش‌محور</span><h1>تیمتان را حول<br><em>مشتری متحد کنید.</em></h1><p>عضویت کاربران سازمانی پس از تأیید مدیر فعال می‌شود تا اصل حداقل دسترسی رعایت شود.</p></div></section><section class="auth-form-wrap"><div class="auth-form"><div class="lang-auth"><button type="button" data-lang-toggle>EN</button></div><p class="eyebrow">شروع همکاری</p><h2>درخواست عضویت</h2>@if(ViewBag.Success!=null){<div class="success-box">✓ @ViewBag.Success</div>}<form method="post">@Html.AntiForgeryToken()<label>نام و نام خانوادگی<input name="name" required placeholder="نام کامل"></label><label>ایمیل سازمانی<input name="email" type="email" required placeholder="name@company.com"></label><label>شرکت / واحد<input name="company" required placeholder="نام سازمان"></label><button class="primary full">ارسال درخواست</button></form><p class="auth-bottom">قبلاً عضو هستید؟ <a href="/Auth/Login">ورود</a></p></div></section><script src="/js/crm.js"></script></body></html>