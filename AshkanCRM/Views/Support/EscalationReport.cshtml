@model List<AshkanCRM.Models.SupportEscalation>
@{ var fa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa"; }
@{ ViewData["Title"] = fa ? "گزارش ارجاع تیکت‌ها" : "Escalation report"; }
<link rel="stylesheet" href="~/css/support-workspace-38.css" asp-append-version="true" />
<main class="agent-workspace">
<header class="agent-header"><div><span class="agent-kicker">SUPPORT GOVERNANCE</span><h1 data-fa="گزارش ارجاع تیکت‌ها" data-en="Escalation report">@(fa ? "گزارش ارجاع تیکت‌ها" : "Escalation report")</h1><p data-fa="سوابق ارجاع دستی و خودکار" data-en="Manual and automatic escalation history">@(fa ? "سوابق ارجاع دستی و خودکار" : "Manual and automatic escalation history")</p></div><a class="agent-cta" asp-action="Workspace" data-fa="میز کار" data-en="Workspace">@(fa ? "میز کار" : "Workspace")</a></header>
<form method="get" asp-action="EscalationReport"><label for="days" data-fa="بازه گزارش" data-en="Report period">@(fa ? "بازه گزارش" : "Report period")</label><select id="days" name="days"><option value="7" selected="@(ViewBag.Days == 7)">@(fa ? "7 روز" : "7 days")</option><option value="30" selected="@(ViewBag.Days == 30)">@(fa ? "30 روز" : "30 days")</option><option value="90" selected="@(ViewBag.Days == 90)">@(fa ? "90 روز" : "90 days")</option></select><button type="submit" data-fa="اعمال" data-en="Apply">@(fa ? "اعمال" : "Apply")</button></form>
<section class="agent-metrics"><div class="agent-metric"><span data-fa="ارجاع خودکار" data-en="Automatic">@(fa ? "ارجاع خودکار" : "Automatic")</span><strong>@ViewBag.Automatic</strong></div><div class="agent-metric"><span data-fa="ارجاع دستی" data-en="Manual">@(fa ? "ارجاع دستی" : "Manual")</span><strong>@ViewBag.Manual</strong></div><div class="agent-metric"><span data-fa="تیکت‌های یکتا" data-en="Unique tickets">@(fa ? "تیکت‌های یکتا" : "Unique tickets")</span><strong>@ViewBag.UniqueTickets</strong></div></section>
<section class="agent-panel"><h2 data-fa="تاریخچه ارجاع‌ها" data-en="Escalation history">@(fa ? "تاریخچه ارجاع‌ها" : "Escalation history")</h2><div class="agent-table-scroll"><table class="agent-table"><thead><tr><th data-fa="تیکت" data-en="Ticket">@(fa ? "تیکت" : "Ticket")</th><th data-fa="نوع" data-en="Type">@(fa ? "نوع" : "Type")</th><th data-fa="دلیل" data-en="Reason">@(fa ? "دلیل" : "Reason")</th><th data-fa="زمان UTC" data-en="UTC time">@(fa ? "زمان UTC" : "UTC time")</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td><a asp-action="Details" asp-route-id="@item.TicketId">#@item.TicketId</a></td><td>@(item.Actor == "SLA Automation" ? (fa ? "خودکار" : "Automatic") : (fa ? "دستی" : "Manual"))</td><td>@item.Reason</td><td>@item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td></tr>
}
</tbody></table></div>@if (Model.Count == 0) { <p data-fa="در این بازه ارجاعی ثبت نشده است." data-en="No escalations in this period.">@(fa ? "در این بازه ارجاعی ثبت نشده است." : "No escalations in this period.")</p> }<p class="agent-footnote" data-fa="حداکثر ۵۰۰ رویداد جدید نمایش داده می‌شود." data-en="Showing at most 500 recent events.">@(fa ? "حداکثر ۵۰۰ رویداد جدید نمایش داده می‌شود." : "Showing at most 500 recent events.")</p></section>
</main>
@section Scripts { <script src="~/js/support-localization.js" asp-append-version="true"></script> }
