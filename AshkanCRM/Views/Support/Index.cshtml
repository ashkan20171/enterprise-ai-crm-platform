@model List<AshkanCRM.Models.SupportTicket>
@{ var isEnglish = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en"; ViewData["Title"] = isEnglish ? "Support Desk" : "مرکز پشتیبانی"; }
<p><a asp-controller="Support" asp-action="Insights" data-fa="تحلیل عملکرد پشتیبانی" data-en="Support analytics">@(isEnglish ? "Support analytics" : "تحلیل عملکرد پشتیبانی")</a></p>
<section class="support-hero"><div><span class="support-eyebrow">CUSTOMER EXPERIENCE / CX</span><h1 data-fa="مرکز پشتیبانی و تیکتینگ" data-en="Support & Ticketing Center">@(isEnglish ? "Support & Ticketing Center" : "مرکز پشتیبانی و تیکتینگ")</h1><p data-fa="مدیریت درخواست‌ها، پیگیری پاسخ‌ها و حل سریع مشکلات مشتریان" data-en="Track requests, collaborate and resolve customer issues faster">@(isEnglish ? "Track requests, collaborate and resolve customer issues faster" : "مدیریت درخواست‌ها، پیگیری پاسخ‌ها و حل سریع مشکلات مشتریان")</p></div><div class="support-hero-icon">✉</div></section>
@if(TempData["SupportError"] is string error){<div class="support-alert">@error</div>}
<div class="support-stats"><div><b>@Model.Count</b><span data-fa="تیکت‌های قابل مشاهده" data-en="Visible tickets">@(isEnglish ? "Visible tickets" : "تیکت‌های قابل مشاهده")</span></div><div><b>@Model.Count(x=>x.Status=="Open"||x.Status=="Reopened")</b><span data-fa="باز" data-en="Open">@(isEnglish ? "Open" : "باز")</span></div><div><b>@Model.Count(x=>x.Status=="InProgress")</b><span data-fa="در حال بررسی" data-en="In progress">@(isEnglish ? "In progress" : "در حال بررسی")</span></div><div><b>@Model.Count(x=>x.Status=="Resolved")</b><span data-fa="حل شده" data-en="Resolved">@(isEnglish ? "Resolved" : "حل شده")</span></div></div>
<div class="support-grid"><section class="support-panel"><h2 data-fa="ثبت تیکت جدید" data-en="Create a ticket">@(isEnglish ? "Create a ticket" : "ثبت تیکت جدید")</h2><form method="post" asp-action="Create"><div asp-validation-summary="All"></div><label data-fa="موضوع" data-en="Subject">@(isEnglish ? "Subject" : "موضوع")</label><input name="Subject" required maxlength="180" data-stage59-placeholder-fa="موضوع درخواست" data-stage59-placeholder-en="Ticket subject" placeholder="موضوع درخواست"/><label data-fa="توضیحات" data-en="Description">@(isEnglish ? "Description" : "توضیحات")</label><textarea name="Description" required maxlength="3000" rows="5"></textarea><label data-fa="دسته‌بندی" data-en="Category">@(isEnglish ? "Category" : "دسته‌بندی")</label><select name="Category"><option value="General" data-stage58-code="General">General</option><option value="Technical" data-stage58-code="Technical">Technical</option><option value="Billing" data-stage58-code="Billing">Billing</option><option value="FeatureRequest" data-stage58-code="FeatureRequest">FeatureRequest</option></select><label data-fa="اولویت" data-en="Priority">@(isEnglish ? "Priority" : "اولویت")</label><select name="Priority"><option value="Low" data-stage58-code="Low">Low</option><option value="Medium" selected data-stage58-code="Medium">Medium</option><option value="High" data-stage58-code="High">High</option><option value="Critical" data-stage58-code="Critical">Critical</option></select><button type="submit" class="support-primary" data-fa="ثبت درخواست" data-en="Submit ticket">@(isEnglish ? "Submit ticket" : "ثبت درخواست")</button></form></section><section class="support-panel"><div class="support-toolbar"><h2 data-fa="صندوق تیکت‌ها" data-en="Ticket inbox">@(isEnglish ? "Ticket inbox" : "صندوق تیکت‌ها")</h2><form method="get"><input name="q" value="@ViewBag.Query" data-stage59-placeholder-fa="جستجوی تیکت‌ها" data-stage59-placeholder-en="Search tickets" placeholder="جستجوی تیکت‌ها"/><select name="status"><option value="" data-stage59-fa="همه وضعیت‌ها" data-stage59-en="All statuses">همه وضعیت‌ها</option>@foreach(var st in new[]{"Open","InProgress","Waiting","Resolved","Closed","Reopened"}){if(ViewBag.Status==st){<option value="@st" selected data-stage58-code="@st">@st</option>}else{<option value="@st" data-stage58-code="@st">@st</option>}}</select><button type="submit">⌕</button></form></div><div class="support-ticket-list">@foreach(var t in Model){<a class="support-ticket" asp-action="Details" asp-route-id="@t.Id"><span class="support-ticket-top"><strong>#@t.Id · @t.Subject</strong><em class="support-status" data-stage58-code="@t.Status">@LocalStatus(t.Status, isEnglish)</em></span><span class="support-ticket-meta"><span data-stage58-code="@t.Priority">@LocalStatus(t.Priority, isEnglish)</span> · <span data-stage58-code="@t.Category">@LocalStatus(t.Category, isEnglish)</span> · @t.Requester · @t.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span></a>}@if(Model.Count==0){<div class="support-empty" data-fa="تیکتی یافت نشد" data-en="No tickets found">@(isEnglish ? "No tickets found" : "تیکتی یافت نشد")</div>}</div></section></div>
@section Scripts { <script src="~/js/support-localization.js" asp-append-version="true"></script> }

@functions {
    private static string LocalStatus(string? value, bool english)
    {
        if (english || string.IsNullOrEmpty(value)) return value ?? "";
        return value switch
        {
            "Open" => "باز", "Reopened" => "بازگشایی‌شده", "InProgress" => "در حال بررسی",
            "Waiting" => "در انتظار", "Resolved" => "حل‌شده", "Closed" => "بسته‌شده",
            "Low" => "کم", "Medium" => "متوسط", "High" => "زیاد", "Critical" => "بحرانی",
            "General" => "عمومی", "Technical" => "فنی", "Billing" => "مالی",
            "FeatureRequest" => "درخواست قابلیت", _ => value
        };
    }
}
