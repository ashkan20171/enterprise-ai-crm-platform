@model List<AshkanCRM.Models.SupportAgentMetric>
@{ var fa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa"; }
@{ ViewData["Title"] = fa ? "عملکرد کارشناسان" : "Agent performance"; }
<link rel="stylesheet" href="~/css/support-workspace-38.css" asp-append-version="true" />
<main class="agent-workspace">
<header class="agent-header"><div><span class="agent-kicker">SUPPORT ANALYTICS</span><h1 data-fa="عملکرد کارشناسان" data-en="Agent performance">@(fa ? "عملکرد کارشناسان" : "Agent performance")</h1><p data-fa="شاخص‌های واقعی بر اساس تمام تیکت‌های ثبت‌شده" data-en="Metrics calculated from all recorded tickets">@(fa ? "شاخص‌های واقعی بر اساس تمام تیکت‌های ثبت‌شده" : "Metrics calculated from all recorded tickets")</p></div><a class="agent-cta" asp-action="Workspace" data-fa="میز کار" data-en="Workspace">@(fa ? "میز کار" : "Workspace")</a></header>
<section class="agent-metrics"><div class="agent-metric"><span data-fa="کل تیکت‌ها" data-en="Total tickets">@(fa ? "کل تیکت‌ها" : "Total tickets")</span><strong>@ViewBag.Total</strong></div><div class="agent-metric"><span data-fa="تیکت‌های فعال بدون مسئول" data-en="Unassigned active tickets">@(fa ? "تیکت‌های فعال بدون مسئول" : "Unassigned active tickets")</span><strong>@ViewBag.Unassigned</strong></div><div class="agent-metric"><span data-fa="کارشناسان دارای تیکت" data-en="Agents with tickets">@(fa ? "کارشناسان دارای تیکت" : "Agents with tickets")</span><strong>@Model.Count</strong></div></section>
<section class="agent-panel"><h2 data-fa="بار کاری و حل درخواست‌ها" data-en="Workload and resolutions">@(fa ? "بار کاری و حل درخواست‌ها" : "Workload and resolutions")</h2><div class="agent-table-scroll"><table class="agent-table"><thead><tr><th data-fa="کارشناس" data-en="Agent">@(fa ? "کارشناس" : "Agent")</th><th data-fa="کل" data-en="Total">@(fa ? "کل" : "Total")</th><th data-fa="فعال" data-en="Active">@(fa ? "فعال" : "Active")</th><th data-fa="حل‌شده" data-en="Resolved">@(fa ? "حل‌شده" : "Resolved")</th><th data-fa="بحرانی فعال" data-en="Critical active">@(fa ? "بحرانی فعال" : "Critical active")</th><th data-fa="میانگین زمان حل (ساعت)" data-en="Average resolution (hours)">@(fa ? "میانگین زمان حل (ساعت)" : "Average resolution (hours)")</th></tr></thead><tbody>@foreach(var row in Model){<tr><td>@row.Agent</td><td>@row.Total</td><td>@row.Active</td><td>@row.Resolved</td><td>@row.CriticalOpen</td><td>@row.AverageResolutionHours.ToString("0.0")</td></tr>}</tbody></table></div>@if(Model.Count==0){<p data-fa="هنوز تیکتی به کارشناس تخصیص نیافته است." data-en="No tickets assigned yet.">@(fa ? "هنوز تیکتی به کارشناس تخصیص نیافته است." : "No tickets assigned yet.")</p>}<p class="agent-footnote" data-fa="میانگین زمان حل فقط برای تیکت‌های دارای تاریخ حل معتبر محاسبه می‌شود؛ این شاخص SLA رسمی نیست." data-en="Average resolution uses tickets with valid resolution timestamps; it is not an official SLA metric.">@(fa ? "میانگین زمان حل فقط برای تیکت‌های دارای تاریخ حل معتبر محاسبه می‌شود؛ این شاخص SLA رسمی نیست." : "Average resolution uses tickets with valid resolution timestamps; it is not an official SLA metric.")</p></section>
</main>
@section Scripts { <script src="~/js/support-localization.js" asp-append-version="true"></script> }
