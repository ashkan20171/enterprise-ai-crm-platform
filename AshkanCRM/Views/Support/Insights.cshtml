@{ ViewData["Title"]="Support Insights"; }
<section class="support-hero"><div><span class="support-eyebrow">SERVICE DESK</span><h1 data-fa="تحلیل عملکرد پشتیبانی" data-en="Support analytics">تحلیل عملکرد پشتیبانی</h1><p data-fa="شاخص‌های واقعی بر اساس تیکت‌های قابل مشاهده شما" data-en="Live metrics for tickets you are authorized to see">شاخص‌های واقعی بر اساس تیکت‌های قابل مشاهده شما</p></div></section>
<div class="support-grid"><article class="support-panel"><h2 data-fa="کل تیکت‌ها" data-en="All tickets">کل تیکت‌ها</h2><strong>@ViewBag.Total</strong></article><article class="support-panel"><h2 data-fa="تیکت‌های باز" data-en="Open tickets">تیکت‌های باز</h2><strong>@ViewBag.Open</strong></article><article class="support-panel"><h2 data-fa="حل‌شده" data-en="Resolved">حل‌شده</h2><strong>@ViewBag.Resolved</strong></article><article class="support-panel"><h2 data-fa="موارد عبور از مهلت پاسخ" data-en="Response SLA at risk">موارد عبور از مهلت پاسخ</h2><strong>@ViewBag.Breaches</strong></article></div>
<p><a asp-action="Index" data-fa="بازگشت به تیکت‌ها" data-en="Back to tickets">بازگشت به تیکت‌ها</a></p>
@section Scripts { <script src="~/js/support-localization.js" asp-append-version="true"></script> }
